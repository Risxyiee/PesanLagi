ss=\"font-display text-lg font-bold text-white\">Tambah Menu Baru</h3>\n        <button onclick=\"closeMenuModal()\" class=\"text-white/40 hover:text-white/80\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M6 18L18 6M6 6l12 12\"/></svg>\n        </button>\n      </div>\n      <form id=\"menu-form\" class=\"p-5 space-y-4\" onsubmit=\"saveMenu(event)\">\n        <input type=\"hidden\" id=\"menu-id\">\n        <div>\n          <label class=\"block text-xs font-medium text-white/50 mb-1.5\">Nama Menu</label>\n          <input type=\"text\" id=\"menu-name\" required class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"Contoh: Nasi Goreng Spesial\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-white/50 mb-1.5\">Deskripsi</label>\n          <textarea id=\"menu-desc\" rows=\"2\" class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"Beri tahu pelanggan apa yang spesial\"></textarea>\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-white/50 mb-1.5\">Harga (Rp)</label>\n            <input type=\"number\" id=\"menu-price\" required class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"15000\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-white/50 mb-1.5\">Kategori</label>\n            <select id=\"menu-cat\" class=\"w-full px-4 py-2.5 rounded-xl\"></select>\n          </div>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-white/50 mb-1.5\">Foto Menu</label>\n          <div class=\"flex items-center gap-4\">\n            <img id=\"menu-img-preview\" src=\"https://picsum.photos/seed/foodplaceholder/200/200.jpg\" class=\"w-14 h-14 rounded-xl object-cover bg-white/[0.06]\" alt=\"Preview\">\n            <button type=\"button\" onclick=\"document.getElementById('menu-img-upload').click()\" class=\"btn-glass px-3 py-1.5 text-xs font-medium rounded-lg\">Pilih Foto</button>\n            <input type=\"file\" id=\"menu-img-upload\" class=\"hidden\" accept=\"image/*\" onchange=\"handleMenuImageUpload(event)\">\n          </div>\n        </div>\n        <div class=\"flex items-center justify-between bg-white/[0.03] p-4 rounded-xl\">\n          <div>\n            <p class=\"text-sm font-medium text-white/80\">Status Ketersediaan</p>\n            <p class=\"text-xs text-white/30\">Matikan jika menu sedang habis</p>\n          </div>\n          <label class=\"relative inline-flex items-center cursor-pointer\">\n            <input type=\"checkbox\" id=\"menu-available\" class=\"sr-only\" checked>\n            <div class=\"toggle-bg\"></div>\n            <div class=\"toggle-dot\"></div>\n          </label>\n        </div>\n        <div class=\"flex gap-3 pt-2\">\n          <button type=\"button\" onclick=\"closeMenuModal()\" class=\"flex-1 py-2.5 btn-glass font-medium rounded-xl\">Batal</button>\n          <button type=\"submit\" id=\"menu-form-submit-btn\" class=\"flex-1 py-2.5 btn-primary font-semibold rounded-xl\">Simpan Menu</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: DELETE CONFIRMATION ================= -->\n  <div id=\"delete-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4\">\n    <div class=\"modal-box w-full max-w-sm p-6 text-center\">\n      <div class=\"w-14 h-14 mx-auto rounded-full bg-red-500/10 flex items-center justify-center mb-4\">\n        <svg class=\"w-7 h-7 text-red-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"/></svg>\n      </div>\n      <h3 class=\"font-display text-lg font-bold text-white mb-2\">Hapus Menu Ini?</h3>\n      <p class=\"text-white/40 text-sm mb-5\">Menu yang dihapus tidak bisa dikembalikan.</p>\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('delete-modal')\" class=\"flex-1 py-2.5 btn-glass font-medium rounded-xl\">Batal</button>\n        <button id=\"confirm-delete-btn\" class=\"flex-1 py-2.5 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600\">Hapus</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: ADD CATEGORY ================= -->\n  <div id=\"cat-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4\">\n    <div class=\"modal-box w-full max-w-sm p-6\">\n      <h3 class=\"font-display text-lg font-bold text-white mb-4\">Tambah Kategori Baru</h3>\n      <input type=\"text\" id=\"new-cat-name\" class=\"w-full px-4 py-2.5 rounded-xl mb-4\" placeholder=\"Contoh: Paket Komplit\" oninput=\"document.getElementById('add-cat-btn').disabled = !this.value.trim()\">\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('cat-modal')\" class=\"flex-1 py-2.5 btn-glass font-medium rounded-xl\">Batal</button>\n        <button id=\"add-cat-btn\" onclick=\"addCategory()\" disabled class=\"flex-1 py-2.5 btn-primary font-semibold rounded-xl disabled:opacity-40 disabled:cursor-not-allowed\">Tambah</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: UPGRADE PRO ================= -->\n  <div id=\"upgrade-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4\">\n    <div class=\"modal-box w-full max-w-md p-6 sm:p-8 text-center\">\n      <div class=\"w-14 h-14 mx-auto rounded-full bg-orange-500/10 flex items-center justify-center mb-5\">\n        <svg class=\"w-7 h-7 text-orange-400\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z\"/></svg>\n      </div>\n      <h3 class=\"font-display text-xl sm:text-2xl font-bold text-white