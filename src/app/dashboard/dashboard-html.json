             </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Aksi Cepat</h3>\n            <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              <button onclick=\"navigateTo('menus')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 4v16m8-8H4\"/></svg>\n                </div>\n                <div>\n                  <p class=\"text-sm font-medium text-slate-800\">Tambah Menu</p>\n                  <p class=\"text-xs text-slate-500\">Buat menu baru</p>\n                </div>\n              </button>\n              <button onclick=\"navigateTo('designer')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/></svg>\n                </div>\n                <div>\n                  <p class=\"text-sm font-medium text-slate-800\">Desain QR</p>\n                  <p class=\"text-xs text-slate-500\">Cetak kartu meja</p>\n                </div>\n              </button>\n              <button onclick=\"navigateTo('settings')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\"