ntColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"/></svg>\n                  Download PDF / PNG High-Res\n                </button>\n              </div>\n            </div>\n\n            <div class=\"flex flex-col items-center justify-center bg-slate-100 rounded-2xl p-6 sm:p-10 relative\">\n              <div class=\"relative w-full max-w-xs\">\n                <div id=\"qr-card\" class=\"relative w-full aspect-[3/4] rounded-2xl shadow-2xl flex flex-col items-center justify-between p-6 transition-colors duration-300\" style=\"background: #E8D0B3;\">\n                  <div class=\"text-center\">\n                    <img id=\"qr-logo\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-12 h-12 rounded-full mx-auto mb-2 object-cover\" alt=\"Logo\">\n                    <h4 id=\"qr-store-name\" class=\"font-display font-bold text-lg\" style=\"color: #4E342E\">--</h4>\n                  </div>\n                  <div class=\"bg-white p-3 rounded-xl shadow-sm w-3/4 aspect-square flex items-center justify-center\">\n                    <div id=\"qrcode\"></div>\n                  </div>\n                  <div class=\"text-center\">\n                    <p class=\"text-[10px] uppercase tracking-widest opacity-60\" style=\"color: #4E342E\">Scan untuk lihat menu</p>\n                    <p class=\"text-xs font-medium opacity-80\" style=\"color: #4E342E\">pesanlagi.web.id</p>\n                    <p id=\"qr-table-number\" class=\"hidden mt-1 text-xs font-bold px-2 py-0.5 rounded-full inline-block\" style=\"background-color: rgba(255,255,255,0.2); color: #4E342E\"></p>\n                  </div>\n                  <div id=\"watermark\" class=\"watermark-overlay hidden bg-black/20 rounded-2xl\">\n                    <div class=\"watermark-text\">PREVIEW MODE - UPGRADE PRO</div>\n                  </div>\n                </div>\n              </div>\n              <p class=\"text-xs text-slate-400 mt-6\">Preview Real-time</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- ============ PAGE: BILLING ============ -->\n        <div id=\"page-billing\" class=\"page-view hidden\">\n          <div class=\"mb-8\">\n            <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Tagihan & Paket</h1>\n            <p class=\"text-slate-500\">Kelola langganan dan metode pembayaranmu.</p>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6\">\n            <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n              <div>\n                <p class=\"text-sm text-slate-500 mb-1\">Paket Aktif Saat Ini</p>\n                <h3 class=\"font-display text-2xl font-bold text-slate-800\">Paket Gratis (Free)</h3>\n                <p class=\"text-sm text-slate-500 mt-1\">Berlaku Selamanya</p>\n              </div>\n              <button onclick=\"document.getElementById('upgrade-modal').classList.remove('hidden')\" class=\"px-5 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/30 hover:from-orange-400 hover:to-orange-500 transition-all\">\n                Upgrade ke Pro\n              </button>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div class=\"bg-white rounded-2xl border-2 border-slate-100 shadow-sm p-6\">\n              <h4 class=\"font-display font-bold text-slate-800 mb-4\">Paket Gratis</h4>\n              <p class=\"font-display text-3xl font-bold text-slate-800 mb-4\">Rp 0<span class=\"text-base font-medium text-slate-500\">/bln</span></p>\n              <ul class=\"space-y-3 text-sm text-slate-600\">\n                <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\