go-preview\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-full h-full object-cover\" alt=\"Logo\">\n                  </div>\n                  <div>\n                    <button type=\"button\" onclick=\"document.getElementById('logo-upload').click()\" class=\"px-4 py-2 text-sm font-medium text-orange-600 border border-orange-200 hover:bg-orange-50 rounded-lg transition-colors\">Ganti Logo</button>\n                    <p class=\"text-xs text-slate-400 mt-1\">PNG/JPG. Maks 1MB.</p>\n                    <input type=\"file\" id=\"logo-upload\" class=\"hidden\" accept=\"image/*\" onchange=\"handleLogoUpload(event)\">\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label for=\"store-name\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Nama Warung</label>\n                <input type=\"text\" id=\"store-name\" value=\"\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" required oninput=\"autoGenerateSlug()\" />\n              </div>\n\n              <div>\n                <label for=\"store-desc\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Deskripsi Warung</label>\n                <textarea id=\"store-desc\" rows=\"3\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"Contoh: Menyediakan masakan rumahan rasa Jawa asli sejak 1995.\"></textarea>\n              </div>\n\n              <div>\n                <label for=\"store-slug\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Link URL Menu (Slug)</label>\n                <div class=\"flex items-center bg-slate-50 border border-slate-200 rounded-xl overflow-hidden focus-within:border-orange-500 focus-within:bg-white transition-all\">\n                  <span class=\"pl-4 pr-2 py-2.5 text-sm text-slate-400 border-r border-slate-200 whitespace-nowrap\">pesanlagi.web.id/menu/</span>\n                  <input type=\"text\" id=\"store-slug\" value=\"warung-pak-bowo\" class=\"flex-1 pl-3 pr-4 py-2.5 bg-transparent text-slate-800 focus:outline-none lowercase\" required oninput=\"formatSlug(this)\" />\n                </div>\n              </div>\n            </form>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 max-w-2xl mb-6\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Kontak & Lokasi</h3>\n            <div class=\"space-y-5\">\n              <div>\n                <label for=\"store-wa\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">No. WhatsApp Warung</label>\n                <input type=\"tel\" id=\"store-wa\" value=\"081234567890\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" />\n              </div>\n              <div>\n                <label for=\"store-addr\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Alamat Lengkap</label>\n                <textarea id=\"store-addr\" rows=\"2\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"Jl. Diponegoro No. 123, Semarang\"></textarea>\n              </div>\n              <div>\n                <label for=\"store-map\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Link Google Maps</label>\n                <input type=\"url\" id=\"store-map\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"https://maps.google.com/...\" />\n              </div>\n            </div>\n          </div>\n