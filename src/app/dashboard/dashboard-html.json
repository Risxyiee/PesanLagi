 2.572-1.065z\"/><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n      <span class=\"text-[10px] font-medium\">Profil</span>\n    </button>\n  </nav>\n\n  <!-- ================= MODAL: ADD/EDIT MENU ================= -->\n  <div id=\"menu-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n      <div class=\"sticky top-0 bg-white p-6 border-b border-slate-100 flex items-center justify-between rounded-t-2xl\">\n        <h3 id=\"modal-title\" class=\"font-display text-xl font-bold text-slate-800\">Tambah Menu Baru</h3>\n        <button onclick=\"closeMenuModal()\" class=\"text-slate-400 hover:text-slate-600\">\n          <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M6 18L18 6M6 6l12 12\"/></svg>\n        </button>\n      </div>\n      \n      <form id=\"menu-form\" class=\"p-6 space-y-5\" onsubmit=\"saveMenu(event)\">\n        <input type=\"hidden\" id=\"menu-id\">\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Nama Menu</label>\n          <input type=\"text\" id=\"menu-name\" required class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"Contoh: Nasi Goreng Spesial\" />\n        </div>\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Deskripsi</label>\n          <textarea id=\"menu-desc\" rows=\"2\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"Beri tahu pelanggan apa yang membuat ini spesial\"></textarea>\n        </div>\n        \n        <div class=\"grid grid-cols-2 gap-4\">\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Harga (Rp)</label>\n            <input type=\"number\" id=\"menu-price\" required class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"15000\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Kategori</label>\n            <select id=\"menu-cat\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\">\n              <!-- Options generated by JS -->\n            </select>\n          </div>\n        </div>\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Foto Menu</label>\n          <div class=\"flex items-center gap-4\">\n            <img id=\"menu-img-preview\" src=\"https://picsum.photos/seed/foodplaceholder/200/200.jpg\" class=\"w-16 h-16 rounded-xl object-cover bg-slate-100\" alt=\"Preview\">\n            <button type=\"button\" onclick=\"document.getElementById('menu-img-input').click()\" class=\"px-3 py-1.5 text-xs font-medium text-orange-600 border border-orange-200 hover:bg-orange-50 rounded-lg\">Pilih Foto</button>\n            <input type=\"file\" id=\"menu-img-input\" class=\"hidden\" accept=\"image/*\" onchange=\"handleMenuImageUpload(event)\">\n          </div>\n        </div>\n        \n        <div class=\"flex items-center justify-between bg-slate-50 p-4 rounded-xl\">\n          <div>\n            <p class=\"text-sm font-medium text-slate-800\">Status Ketersediaan</p>\n            <p class=\"text-xs text-slate-500\">Matikan jika menu sedang habis</p>\n          </div>\n          <label class=\"relative inline-flex items-center cursor-pointer\">\n            <input type=\"checkbox\" id=\"menu-available\" class=\"sr-only\" checked>\n            <div class=\"toggle-bg w-11 h-6 bg-slate-200 rounded-full\"></div>\n            <div class=\"toggle-dot absolute left-1 top-1 w-4 h-4 bg-white rounded-full shadow\"></div>\n          </label>\n        </div>\n        \n        <div class=\"flex gap-3 pt-2\">\n          <button type=\"button\" onclick=\"closeMenuModal()\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n          <button type=\"submit\" class=\"flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/20 hover:from-orange-400 hover:to-orange-500\">Simpan Menu</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: DELETE CONFIRMATION ================= -->\n  <div id=\"delete-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center\">\n      <div class=\"w-16 h-16 mx-auto rounded-full bg-red-50 flex items-center justify-center mb-5\">\n        <svg class=\"w-8 h-8 text-red-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"/></svg>\n      </div>\n      <h3 class=\"font-display text-xl font-bold text-slate-800 mb-2\">Hapus Menu Ini?</h3>\n      <p class=\"text-slate-500 text-sm mb-6\">Menu yang dihapus tidak bisa dikembalikan. Yakin ingin melanjutkan?</p>\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('delete-modal')\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n        <button id=\"confirm-delete-btn\" class=\"flex-1 py-2.5 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600\">Hapus</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: ADD CATEGORY ================= -->\n  <div id=\"cat-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-sm p-6\">\n      <h3 class=\"font-display text-xl font-bold text-slate-800 mb-4\">Tambah Kategori Baru</h3>\n      <input type=\"text\" id=\"new-cat-name\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white mb-4\" placeholder=\"Contoh: Paket Komplit\" oninput=\"document.getElementById('add-cat-btn').disabled = !this.value.trim()\">\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('cat-modal')\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n        <button id=\"add-cat-btn\" onclick=\"addCategory()\" disabled class=\"flex-1 py-2.5 bg-orange-500 text-white font-semibold rounded-xl hover:bg-orange-600 disabled:opacity-50 disabled:cursor-not-allowed\">Tambah</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: UPGRADE PRO ================= -->\n  <div id=\"upgrade-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-md p-8 text-center\">\n      <div class=\"w-16 h-16 mx-auto rounded-full bg-orange-100 flex items-center justify-center mb-5\">\n        <svg class=\"w-8 h-8 text-orange-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z\"/></svg>\n      </div>\n      <h3 class=\"font-display text-2xl font-bold text-slate-800 mb-2\">Upgrade ke Paket Pro</h3>\n      <p class=\"text-slate-500 mb-6\">Untuk menggunakan warna kustom dan menghilangkan watermark, kamu perlu upgrade akun ke Paket Pro.</p>\n      \n      <div class=\"bg-slate-50 rounded-xl p-4 mb-6 text-left\">\n        <div class=\"flex items-center gap-2 text-sm text-slate-700 mb-2\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Download PDF/PNG Tanpa Watermark\n        </div>\n        <div class=\"flex items-center gap-2 text-sm text-slate-700 mb-2\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Warna Kustom & Template Premium\n        </div>\n        <div class=\"flex items-center gap-2 text-sm text-slate-700\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Support Priority via WhatsApp\n        </div>\n      </div>\n      \n      <button onclick=\"closeModal('upgrade-modal'); showToast('Mengarahkan ke halaman pembayaran...')\" class=\"w-full py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/30 hover:scale-[1.02] transition-all mb-2\">\n        Upgrade Sekarang - Rp 29.000/bln\n      </button>\n      <button onclick=\"closeModal('upgrade-modal')\" class=\"w-full py-2 text-sm text-slate-400 hover:text-slate-600 font-medium\">Nanti Saja</button>\n    </div>\n  </div>\n\n  <!-- Toast Notification -->\n  <div id=\"toast\" class=\"fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-5 py-3 rounded-xl shadow-lg opacity-0 transition-opacity duration-300 z-[100] flex items-center gap-2 pointer-events-none\">\n    <svg class=\"w-5 h-5 text-orange-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n    <span id=\"toast-message\">Berhasil!</span>\n  </div>\n\n  <script>\n    // ==========================================\n    // MOCK STATE & DB\n    // ==========================================\n    const InsForgeDB = {\n      users: { id: 'usr_123', email: 'pakbowo@warung.com', is_pro: false },\n      stores: { id: 'store_1', user_id: 'usr_123', name: 'Warung Pak Bowo', slug: 'warung-pak-bowo', logo_url: 'https://picsum.photos/seed/warunglogo/200/200.jpg' },\n      categories: ['Makanan', 'Minuman', 'Snack'],\n      menus: [\n        { id: 'm1', name: 'Nasi Goreng Spesial', desc: 'Nasi goreng dengan telur, ayam, dan kerupuk', price: 18000, category: 'Makanan', image_url: 'https://picsum.photos/seed/nasigoreng/400/400.jpg', is_available: true },\n        { id: 'm2', name: 'Mie Goreng Jawa', desc: 'Mie goreng dengan sayuran dan telur', price: 15000, category: 'Makanan', image_url: 'https://picsum.photos/seed/miegoreng/400/400.jpg', is_available: true },\n        { id: 'm3', name: 'Es Teh Manis', desc: 'Teh manis dingin segar', price: 5000, category: 'Minuman', image_url: 'https://picsum.photos/seed/esteh/400/400.jpg', is_available: true },\n        { id: 'm4', name: 'Kopi Susu Gula Aren', desc: 'Kopi susu dengan gula aren asli', price: 12000, category: 'Minuman', image_url: 'https://picsum.photos/seed/kopisusu/400/400.jpg', is_available: false },\n      ],\n      saveStore: (data) => { InsForgeDB.stores = {...InsForgeDB.stores, ...data}; return true; },\n      saveMenu: (menu) => {\n        if (menu.id) {\n          const idx = InsForgeDB.menus.findIndex(m => m.id === menu.id);\n          if(idx > -1) InsForgeDB.menus[idx] = menu;\n        } else {\n          menu.id = 'm' + Date.now();\n          InsForgeDB.menus.push(menu);\n        }\n      },\n      deleteMenu: (id) => { InsForgeDB.menus = InsForgeDB.menus.filter(m => m.id !== id); }\n    };\n\n    let currentMenuFilter = 'all';\n    let isCustomColor = false;\n    let menuToDelete = null;\n    let draggedId = null;\n\n    // ==========================================\n    // NAVIGATION\n    // ==========================================\n    function navigateTo(page) {\n      document.querySelectorAll('.page-view').forEach(p => p.classList.add('hidden'));\n      const target = document.getElementById('page-' + page);\n      if (target) {\n        target.classList.remove('hidden');\n        target.style.animation = 'none';\n        target.offsetHeight;\n        target.style.animation = '';\n      }\n      \n      document.querySelectorAll('.nav-link, .mob-nav').forEach(link => {\n        if (link.dataset.page === page) {\n          link.classList.add('active', 'bg-orange-500/10', 'text-orange-500');\n          link.classList.remove('text-slate-400', 'hover:bg-white/5', 'hover:text-white');\n        } else {\n          link.classList.remove('active', 'bg-orange-500/10', 'text-orange-500');\n          link.classList.add('text-slate-400');\n          if (link.classList.contains('nav-link')) link.classList.add('hover:bg-white/5', 'hover:text-white');\n        }\n      });\n\n      if (page === 'overview') document.getElementById('stat-total-menus').textContent = InsForgeDB.menus.length;\n      if (page === 'menus') { renderCategories(); renderMenus(); }\n      if (page === 'designer') initQRDesigner();\n    }\n\n    // ==========================================\n    // SETTINGS LOGIC\n    // ==========================================\n    function autoGenerateSlug() {\n      const name = document.getElementById('store-name').value;\n      const slugInput = document.getElementById('store-slug');\n      if (!slugInput.dataset.touched) {\n        slugInput.value = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n      }\n    }\n\n    function formatSlug(input) {\n      input.dataset.touched = true;\n      input.value = input.value.toLowerCase().replace(/\\s+/g, '-').replace(/[^a-z0-9-]/g, '');\n    }\n\n    function handleLogoUpload(e) {\n      const file = e.target.files[0];\n      if (file) {\n        const reader = new FileReader();\n        reader.onload = (ev) => {\n          document.getElementById('logo-preview').src = ev.target.result;\n          showToast('Logo diupload ke InsForge Storage...');\n        };\n        reader.readAsDataURL(file);\n      }\n    }\n\n    async function saveSettings() {\n      const btn = document.getElementById('settings-submit-btn');\n      setLoading(btn, true, 'Menyimpan...');\n      await new Promise(r => setTimeout(r, 1000));\n      InsForgeDB.saveStore({\n        name: document.getElementById('store-name').value,\n        slug: document.getElementById('store-slug').value,\n        logo_url: document.getElementById('logo-preview').src\n      });\n      setLoading(btn, false);\n      showToast('Profil warung berhasil disimpan!');\n    }\n\n    // ==========================================\n    // MENUS LOGIC (CRUD + SEARCH + DRAG DROP)\n    // ==========================================\n    function renderCategories() {\n      const container = document.getElementById('category-pills');\n      let html = `<button class=\"cat-pill ${currentMenuFilter === 'all' ? 'active bg-orange-500 text-white' : 'bg-white text-slate-600'} px-4 py-2 text-sm font-medium rounded-full whitespace-nowrap transition-colors\" data-cat=\"all\" onclick=\"setCategory('all')\">Semua</button>`;\n      InsForgeDB.categories.forEach(cat => {\n        html += `<button class=\"cat-pill ${currentMenuFilter === cat ? 'active bg-orange-500 text-white' : 'bg-white text-slate-600'} px-4 py-2 text-sm font-medium rounded-full whitespace-nowrap transition-colors\" data-cat=\"${cat}\" onclick=\"setCategory('${cat}')\">${cat}</button>`;\n      });\n      html += `<button onclick=\"document.getElementById('cat-modal').classList.remove('hidden')\" class=\"px-4 py-2 text-sm font-medium rounded-full whitespace-nowrap border-2 border-dashed border-slate-200 text-slate-400 hover:border-orange-500 hover:text-orange-500 transition-colors\">+ Kategori</button>`;\n      container.innerHTML = html;\n\n      // Also update select in modal\n      const select = document.getElementById('menu-cat');\n      select.innerHTML = InsForgeDB.categories.map(c => `<option>${c}</option>`).join('');\n    }\n\n    function setCategory(cat) {\n      currentMenuFilter = cat;\n      renderCategories();\n      renderMenus();\n    }\n\n    function addCategory() {\n      const newCat = document.getElementById('new-cat-name').value.trim();\n      if (newCat && !InsForgeDB.categories.includes(newCat)) {\n        InsForgeDB.categories.push(newCat);\n        renderCategories();\n        showToast('Kategori baru ditambahkan!');\n      }\n      document.getElementById('new-cat-name').value = '';\n      closeModal('cat-modal');\n    }\n\n    function renderMenus() {\n      const grid = document.getElementById('menu-grid');\n      const searchQuery = document.getElementById('search-menu').value.toLowerCase();\n      const menus = InsForgeDB.menus.filter(m => \n        (currentMenuFilter === 'all' || m.category === currentMenuFilter) &&\n        (m.name.toLowerCase().includes(searchQuery) || m.desc.toLowerCase().includes(searchQuery))\n      );\n      \n      document.getElementById('total-menus').textContent = InsForgeDB.menus.length;\n      \n      if (menus.length === 0) {\n        grid.innerHTML = `\n          <div class=\"col-span-full text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200\">\n            <svg class=\"w-16 h-16 mx-auto text-slate-300 mb-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><path d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/></svg>\n            <h4 class=\"font-display font-bold text-slate-700 mb-1\">Menu tidak ditemukan</h4>\n            <p class=\"text-sm text-slate-400\">Coba kata kunci lain atau tambah menu baru.</p>\n          </div>`;\n        return;\n      }\n\n      grid.innerHTML = menus.map(m => `\n        <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden group cursor-move\" draggable=\"true\" ondragstart=\"dragStart(event, '${m.id}')\" ondragover=\"dragOver(event)\" ondrop=\"drop(event, '${m.id}')\">\n          <div class=\"relative h-40 overflow-hidden\">\n            <img src=\"${m.image_url}\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\" alt=\"${m.name}\">\n            ${!m.is_available ? '<div class=\"absolute inset-0 bg-black/50 flex items-center justify-center text-white font-bold text-sm\">HABIS</div>' : ''}\n            <div class=\"absolute top-2 right-2 bg-white/80 backdrop-blur p-1 rounded-md opacity-0 group-hover:opacity-100 transition-opacity\">\n              <svg class=\"w-4 h-4 text-slate-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M5 9l-3 3m0 0l3 3m-3-3h18m0 0l-3-3m3 3l-3 3\"/></svg>\n            </div>\n          </div>\n          <div class=\"p-4\">\n            <div class=\"flex items-start justify-between gap-2 mb-1\">\n              <h4 class=\"font-display font-bold text-slate-800 text-sm leading-tight\">${m.name}</h4>\n              <span class=\"text-xs font-bold text-orange-600 whitespace-nowrap\">Rp ${m.price.toLocaleString('id-ID')}</span>\n            </div>\n            <p class=\"text-xs text-slate-500 mb-3 line-clamp-2\">${m.desc}</p>\n            <div class=\"flex gap-2\">\n              <button onclick=\"editMenu('${m.id}')\" class=\"flex-1 py-1.5 text-xs font-medium text-slate-600 border border-slate-200 hover:bg-slate-50 rounded-lg\">Edit</button>\n              <button onclick=\"deleteMenu('${m.id}')\" class=\"flex-1 py-1.5 text-xs font-medium text-red-500 border border-red-100 hover:bg-red-50 rounded-lg\">Hapus</button>\n            </div>\n          </div>\n        </div>\n      `).join('');\n    }\n\n    // Drag & Drop Handlers\n    function dragStart(e, id) {\n      draggedId = id;\n      e.target.classList.add('dragging');\n    }\n\n    function dragOver(e) {\n      e.preventDefault();\n      e.currentTarget.classList.add('drag-over');\n    }\n\n    function drop(e, targetId) {\n      e.preventDefault();\n      e.currentTarget.classList.remove('drag-over');\n      \n      if (draggedId && draggedId !== targetId) {\n        const draggedIndex = InsForgeDB.menus.findIndex(m => m.id === draggedId);\n        const targetIndex = InsForgeDB.menus.findIndex(m => m.id === targetId);\n        \n        // Remove dragged item and insert at target index\n        const [draggedItem] = InsForgeDB.menus.splice(draggedIndex, 1);\n        InsForgeDB.menus.splice(targetIndex, 0, draggedItem);\n        \n        renderMenus();\n        showToast('Urutan menu berhasil diubah!');\n      }\n    }\n\n    function openMenuModal() {\n      document.getElementById('modal-title').innerText = 'Tambah Menu Baru';\n      document.getElementById('menu-form').reset();\n      document.getElementById('menu-id').value = '';\n      document.getElementById('menu-img-preview').src = 'https://picsum.photos/seed/foodplaceholder/200/200.jpg';\n      document.getElementById('menu-available').checked = true;\n      renderCategories(); // Ensure dropdown is populated\n      document.getElementById('menu-modal').classList.remove('hidden');\n    }\n\n    function editMenu(id) {\n      const m = InsForgeDB.menus.find(x => x.id === id);\n      if (!m) return;\n      \n      document.getElementById('modal-title').innerText = 'Edit Menu';\n      document.getElementById('menu-id').value = m.id;\n      document.getElementById('menu-name').value = m.name;\n      document.getElementById('menu-desc').value = m.desc;\n      document.getElementById('menu-price').value = m.price;\n      document.getElementById('menu-cat').value = m.category;\n      document.getElementById('menu-img-preview').src = m.image_url;\n      document.getElementById('menu-available').checked = m.is_available;\n      \n      document.getElementById('menu-modal').classList.remove('hidden');\n    }\n\n    function deleteMenu(id) {\n      menuToDelete = id;\n      document.getElementById('delete-modal').classList.remove('hidden');\n    }\n\n    document.getElementById('confirm-delete-btn').addEventListener('click', () => {\n      if (menuToDelete) {\n        InsForgeDB.deleteMenu(menuToDelete);\n        renderMenus();\n        showToast('Menu berhasil dihapus.');\n        menuToDelete = null;\n      }\n      closeModal('delete-modal');\n    });\n\n    function handleMenuImageUpload(e) {\n      const file = e.target.files[0];\n      if (file) {\n        const reader = new FileReader();\n        reader.onload = (ev) => {\n          document.getElementById('menu-img-preview').src = ev.target.result;\n          showToast('Foto diupload ke InsForge Storage...');\n        };\n        reader.readAsDataURL(file);\n      }\n    }\n\n    function saveMenu(e) {\n      e.preventDefault();\n      const id = document.getElementById('menu-id').value;\n      const menuData = {\n        id: id || null,\n        name: document.getElementById('menu-name').value,\n        desc: document.getElementById('menu-desc').value,\n        price: parseInt(document.getElementById('menu-price').value),\n        category: document.getElementById('menu-cat').value,\n        image_url: document.getElementById('menu-img-preview').src,\n        is_available: document.getElementById('menu-available').checked\n      };\n      \n      InsForgeDB.saveMenu(menuData);\n      closeMenuModal();\n      renderMenus();\n      showToast(id ? 'Menu berhasil diperbarui!' : 'Menu baru berhasil ditambahkan!');\n    }\n\n    function closeMenuModal() {\n      document.getElementById('menu-modal').classList.add('hidden');\n    }\n\n    // ==========================================\n    // DESIGNER LOGIC\n    // ==========================================\n    function initQRDesigner() {\n      generateQRCode();\n      updateCardUI(); // To show table number if any\n    }\n\n    function generateQRCode() {\n      const qrContainer = document.getElementById('qrcode');\n      if (!qrContainer) return;\n      qrContainer.innerHTML = '';\n      const slug = InsForgeDB.stores.slug;\n      const url = `https://pesanlagi.web.id/menu/${slug}`;\n      \n      new QRCode(qrContainer, {\n        text: url,\n        width: 120,\n        height: 120,\n        colorDark: document.getElementById('qr-color').value,\n        colorLight: \"#ffffff\",\n        correctLevel: QRCode.CorrectLevel.H\n      });\n    }\n\n    function applyPreset(presetName) {\n      let bg, qr;\n      if (presetName === 'kopi-susu') { bg = '#E8D0B3'; qr = '#4E342E'; isCustomColor = false; }\n      else if (presetName === 'sage-segar') { bg = '#B2AC88'; qr = '#1A1A1A'; isCustomColor = false; }\n      else if (presetName === 'midnight-orange') { bg = '#1A1A1A'; qr = '#FF6D00'; isCustomColor = false; }\n      else if (presetName === 'neon-cyber') { bg = '#0F0F0F'; qr = '#00F0FF'; isCustomColor = true; }\n      else if (presetName === 'warm-pastel') { bg = '#FFE4E6'; qr = '#DB2777'; isCustomColor = true; }\n      else if (presetName === 'minimalist-black') { bg = '#FFFFFF'; qr = '#000000'; isCustomColor = true; }\n      \n      document.getElementById('bg-color').value = bg;\n      document.getElementById('qr-color').value = qr;\n      \n      updateCardUI();\n      checkFreemiumLogic();\n    }\n\n    function setBgColor(color) {\n      isCustomColor = true;\n      document.getElementById('bg-color').value = color;\n      updateCardUI();\n      checkFreemiumLogic();\n    }\n\n    function setQrColor(color) {\n      isCustomColor = true;\n      document.getElementById('qr-color').value = color;\n      updateCardUI();\n      checkFreemiumLogic();\n    }\n\n    function applyCustomColor() {\n      isCustomColor = true;\n      updateCardUI();\n      checkFreemiumLogic();\n    }\n\n    function updateCardUI() {\n      const bg = document.getElementById('bg-color').value;\n      const qr = document.getElementById('qr-color').value;\n      const tableNum = document.getElementById('table-number').value;\n      \n      const card = document.getElementById('qr-card');\n      card.style.backgroundColor = bg;\n      \n      const texts = card.querySelectorAll('h4, p');\n      texts.forEach(t => t.style.color = qr);\n      \n      const tableNumEl = document.getElementById('qr-table-number');\n      if (tableNum.trim()) {\n        tableNumEl.textContent = tableNum;\n        tableNumEl.classList.remove('hidden');\n        tableNumEl.style.color = qr;\n        tableNumEl.style.backgroundColor = `rgba(255,255,255,0.2)`;\n      } else {\n        tableNumEl.classList.add('hidden');\n      }\n      \n      generateQRCode();\n    }\n\n    function checkFreemiumLogic() {\n      const isPro = InsForgeDB.users.is_pro;\n      const watermark = document.getElementById('watermark');\n      const proBadge = document.getElementById('pro-badge-custom');\n      \n      if (!isPro && isCustomColor) {\n        watermark.classList.remove('hidden');\n        proBadge.classList.remove('hidden');\n      } else {\n        watermark.classList.add('hidden');\n        if (!isCustomColor) proBadge.classList.add('hidden');\n      }\n    }\n\n    function handleSaveDesign() {\n      const isPro = InsForgeDB.users.is_pro;\n      const bg = document.getElementById('bg-color').value;\n      const qr = document.getElementById('qr-color').value;\n      \n      if (!isPro && isCustomColor) {\n        document.getElementById('upgrade-modal').classList.remove('hidden');\n      } else {\n        InsForgeDB.saveStore({ bg_color: bg, qr_color: qr });\n        showToast('Desain kartu berhasil disimpan!');\n      }\n    }\n\n    function handleDownload() {\n      const isPro = InsForgeDB.users.is_pro;\n      \n      if (!isPro && isCustomColor) {\n        document.getElementById('upgrade-modal').classList.remove('hidden');\n      } else {\n        showToast('Mengunduh PDF High-Res tanpa watermark...');\n      }\n    }\n\n    // ==========================================\n    // UTILITY FUNCTIONS\n    // ==========================================\n    function setLoading(btn, isLoading, text) {\n      if (!btn) return;\n      if (isLoading) {\n        btn.disabled = true;\n        btn.dataset.originalText = btn.innerHTML;\n        btn.innerHTML = `<svg class=\"animate-spin inline-block w-5 h-5 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path></svg>${text}`;\n      } else {\n        btn.disabled = false;\n        btn.innerHTML = btn.dataset.originalText;\n      }\n    }\n\n    function showToast(message) {\n      const toast = document.getElementById('toast');\n      document.getElementById('toast-message').textContent = message;\n      toast.style.opacity = '1';\n      setTimeout(() => toast.style.opacity = '0', 3000);\n    }\n\n    function closeModal(id) {\n      document.getElementById(id).classList.add('hidden');\n    }\n\n    function handleLogout() {\n      showToast('Berhasil logout. Mengarahkan ke /auth/login...');\n      setTimeout(() => { window.location.href = '#'; }, 1500);\n    }\n\n    // INIT DASHBOARD\n    navigateTo('overview');\n  </script>\n"