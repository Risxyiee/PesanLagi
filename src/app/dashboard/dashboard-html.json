"\n\n  <div class=\"flex min-h-screen\">\n    \n    <!-- ================= SIDEBAR (DESKTOP) ================= -->\n    <aside class=\"hidden md:flex flex-col w-64 bg-[#0A0705] text-white fixed h-screen z-30\">\n      <div class=\"p-6 flex items-center gap-2.5 border-b border-white/5\">\n        <div class=\"w-9 h-9 rounded-xl bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center shadow-lg shadow-orange-500/30\">\n          <svg class=\"w-5 h-5 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><path d=\"M14 14h3v3h-3z M17 17h4 M14 21h3 M21 14v3 M21 21v.01\"/></svg>\n        </div>\n        <span class=\"font-display font-bold text-lg\">PesanLagi</span>\n      </div>\n      \n      <nav class=\"flex-1 p-4 space-y-1 overflow-y-auto\">\n        <button onclick=\"navigateTo('overview')\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-colors\" data-page=\"overview\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\"/></svg>\n          Ringkasan\n        </button>\n        <button onclick=\"navigateTo('settings')\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-colors\" data-page=\"settings\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n          Profil Warung\n        </button>\n        <button onclick=\"navigateTo('menus')\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-colors\" data-page=\"menus\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"/></svg>\n          Kelola Menu\n        </button>\n        <button onclick=\"navigateTo('designer')\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-colors\" data-page=\"designer\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/><path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/><path d=\"M2 2l7.586 7.586\"/><circle cx=\"11\" cy=\"11\" r=\"2\"/></svg>\n          Editor QR Code\n        </button>\n        <button onclick=\"navigateTo('billing')\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-white transition-colors\" data-page=\"billing\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z\"/></svg>\n          Tagihan & Paket\n        </button>\n      </nav>\n      \n      <div class=\"p-4 border-t border-white/5\">\n        <div class=\"flex items-center gap-3 mb-3 px-2\">\n          <div class=\"w-9 h-9 rounded-full bg-gradient-to-br from-orange-400 to-red-500 flex items-center justify-center text-sm font-bold text-white\">BW</div>\n          <div class=\"flex-1 min-w-0\">\n            <p class=\"text-sm font-medium text-white truncate\">pakbowo@warung.com</p>\n            <p class=\"text-xs text-orange-400/80\">Paket Gratis</p>\n          </div>\n        </div>\n        <button onclick=\"handleLogout()\" class=\"w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n          Keluar\n        </button>\n      </div>\n    </aside>\n\n    <!-- ================= MAIN CONTENT ================= -->\n    <main class=\"flex-1 md:ml-64 pb-20 md:pb-0\">\n      \n      <header class=\"md:hidden sticky top-0 bg-white border-b border-slate-100 z-20 px-4 py-3 flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center\">\n            <svg class=\"w-4 h-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><path d=\"M14 14h3v3h-3z M17 17h4 M14 21h3 M21 14v3 M21 21v.01\"/></svg>\n          </div>\n          <span class=\"font-display font-bold text-slate-800\">PesanLagi</span>\n        </div>\n        <button onclick=\"handleLogout()\" class=\"p-2 text-slate-500 hover:text-red-500\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n        </button>\n      </header>\n\n      <div class=\"p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto\">\n        \n        <!-- ============ PAGE: OVERVIEW ============ -->\n        <div id=\"page-overview\" class=\"page-view hidden\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8\">\n            <div>\n              <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Ringkasan Warung</h1>\n              <p class=\"text-slate-500\">Selamat datang kembali, Pak Bowo!</p>\n            </div>\n            <a href=\"https://pesanlagi.web.id/menu/warung-pak-bowo\" target=\"_blank\" class=\"px-4 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium rounded-xl flex items-center justify-center gap-2 transition-colors\">\n              <svg class=\"w-5 h-5 text-orange-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/><path d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\"/></svg>\n              Lihat Menu Publik\n            </a>\n          </div>\n          \n          <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n            <div class=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n              <div class=\"w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16M4 10h16M4 14h16M4 18h16\"/></svg>\n              </div>\n              <div>\n                <p class=\"text-sm text-slate-500\">Total Menu</p>\n                <p class=\"text-2xl font-bold text-slate-800\" id=\"stat-total-menus\">4</p>\n              </div>\n            </div>\n            <div class=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n              <div class=\"w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/><path d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\"/></svg>\n              </div>\n              <div>\n                <p class=\"text-sm text-slate-500\">Scan Bulan Ini</p>\n                <p class=\"text-2xl font-bold text-slate-800\">1.205</p>\n              </div>\n            </div>\n            <div class=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n              <div class=\"w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center text-green-500\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg>\n              </div>\n              <div>\n                <p class=\"text-sm text-slate-500\">Status Langganan</p>\n                <p class=\"text-2xl font-bold text-slate-800\">Gratis</p>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\n            <div class=\"lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n              <h3 class=\"font-display font-bold text-slate-800 mb-4\">Statistik Scan (7 Hari Terakhir)</h3>\n              <div class=\"flex items-end justify-between gap-2 h-40 pt-4\">\n                <!-- Simple CSS Chart -->\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-100 rounded-t-lg group-hover:bg-orange-200 transition-colors\" style=\"height: 40%\"></div>\n                  <span class=\"text-xs text-slate-400\">Sen</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-200 rounded-t-lg group-hover:bg-orange-300 transition-colors\" style=\"height: 60%\"></div>\n                  <span class=\"text-xs text-slate-400\">Sel</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-100 rounded-t-lg group-hover:bg-orange-200 transition-colors\" style=\"height: 30%\"></div>\n                  <span class=\"text-xs text-slate-400\">Rab</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-300 rounded-t-lg group-hover:bg-orange-400 transition-colors\" style=\"height: 80%\"></div>\n                  <span class=\"text-xs text-slate-400\">Kam</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-400 rounded-t-lg group-hover:bg-orange-500 transition-colors\" style=\"height: 95%\"></div>\n                  <span class=\"text-xs text-slate-400\">Jum</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-500 rounded-t-lg group-hover:bg-orange-600 transition-colors\" style=\"height: 100%\"></div>\n                  <span class=\"text-xs text-slate-400\">Sab</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-2 flex-1 group\">\n                  <div class=\"w-full bg-orange-300 rounded-t-lg group-hover:bg-orange-400 transition-colors\" style=\"height: 75%\"></div>\n                  <span class=\"text-xs text-slate-400\">Min</span>\n                </div>\n              </div>\n            </div>\n            <div class=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n              <h3 class=\"font-display font-bold text-slate-800 mb-4\">Menu Terpopuler</h3>\n              <div class=\"space-y-3\">\n                <div class=\"flex items-center gap-3\">\n                  <img src=\"https://picsum.photos/seed/nasigoreng/400/400.jpg\" class=\"w-10 h-10 rounded-lg object-cover\" alt=\"Nasi Goreng\">\n                  <div class=\"flex-1\">\n                    <p class=\"text-sm font-medium text-slate-800\">Nasi Goreng Spesial</p>\n                    <p class=\"text-xs text-slate-400\">450x dilihat</p>\n                  </div>\n                  <span class=\"text-xs font-bold text-orange-500\">#1</span>\n                </div>\n                <div class=\"flex items-center gap-3\">\n                  <img src=\"https://picsum.photos/seed/esteh/400/400.jpg\" class=\"w-10 h-10 rounded-lg object-cover\" alt=\"Es Teh\">\n                  <div class=\"flex-1\">\n                    <p class=\"text-sm font-medium text-slate-800\">Es Teh Manis</p>\n                    <p class=\"text-xs text-slate-400\">320x dilihat</p>\n                  </div>\n                  <span class=\"text-xs font-bold text-slate-400\">#2</span>\n                </div>\n                <div class=\"flex items-center gap-3\">\n                  <img src=\"https://picsum.photos/seed/miegoreng/400/400.jpg\" class=\"w-10 h-10 rounded-lg object-cover\" alt=\"Mie Goreng\">\n                  <div class=\"flex-1\">\n                    <p class=\"text-sm font-medium text-slate-800\">Mie Goreng Jawa</p>\n                    <p class=\"text-xs text-slate-400\">280x dilihat</p>\n                  </div>\n                  <span class=\"text-xs font-bold text-slate-400\">#3</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Aksi Cepat</h3>\n            <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              <button onclick=\"navigateTo('menus')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 4v16m8-8H4\"/></svg>\n                </div>\n                <div>\n                  <p class=\"text-sm font-medium text-slate-800\">Tambah Menu</p>\n                  <p class=\"text-xs text-slate-500\">Buat menu baru</p>\n                </div>\n              </button>\n              <button onclick=\"navigateTo('designer')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/></svg>\n                </div>\n                <div>\n                  <p class=\"text-sm font-medium text-slate-800\">Desain QR</p>\n                  <p class=\"text-xs text-slate-500\">Cetak kartu meja</p>\n                </div>\n              </button>\n              <button onclick=\"navigateTo('settings')\" class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-left\">\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n                </div>\n                <div>\n                  <p class=\"text-sm font-medium text-slate-800\">Edit Profil</p>\n                  <p class=\"text-xs text-slate-500\">Ubah nama & jam buka</p>\n                </div>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <!-- ============ PAGE: SETTINGS ============ -->\n        <div id=\"page-settings\" class=\"page-view hidden\">\n          <div class=\"mb-8\">\n            <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Profil Warung</h1>\n            <p class=\"text-slate-500\">Atur informasi dasar, kontak, dan jam operasional warungmu.</p>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 max-w-2xl mb-6\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Informasi Dasar</h3>\n            <form id=\"settings-form\" class=\"space-y-5\">\n              <div>\n                <label class=\"block text-sm font-medium text-slate-700 mb-2\">Logo Warung</label>\n                <div class=\"flex items-center gap-5\">\n                  <div class=\"relative w-20 h-20 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center overflow-hidden\">\n                    <img id=\"logo-preview\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-full h-full object-cover\" alt=\"Logo\">\n                  </div>\n                  <div>\n                    <button type=\"button\" onclick=\"document.getElementById('logo-input').click()\" class=\"px-4 py-2 text-sm font-medium text-orange-600 border border-orange-200 hover:bg-orange-50 rounded-lg transition-colors\">Ganti Logo</button>\n                    <p class=\"text-xs text-slate-400 mt-1\">PNG/JPG. Maks 1MB.</p>\n                    <input type=\"file\" id=\"logo-input\" class=\"hidden\" accept=\"image/*\" onchange=\"handleLogoUpload(event)\">\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label for=\"store-name\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Nama Warung</label>\n                <input type=\"text\" id=\"store-name\" value=\"Warung Pak Bowo\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" required oninput=\"autoGenerateSlug()\" />\n              </div>\n\n              <div>\n                <label for=\"store-desc\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Deskripsi Warung</label>\n                <textarea id=\"store-desc\" rows=\"3\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"Contoh: Menyediakan masakan rumahan rasa Jawa asli sejak 1995.\"></textarea>\n              </div>\n\n              <div>\n                <label for=\"store-slug\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Link URL Menu (Slug)</label>\n                <div class=\"flex items-center bg-slate-50 border border-slate-200 rounded-xl overflow-hidden focus-within:border-orange-500 focus-within:bg-white transition-all\">\n                  <span class=\"pl-4 pr-2 py-2.5 text-sm text-slate-400 border-r border-slate-200 whitespace-nowrap\">pesanlagi.web.id/menu/</span>\n                  <input type=\"text\" id=\"store-slug\" value=\"warung-pak-bowo\" class=\"flex-1 pl-3 pr-4 py-2.5 bg-transparent text-slate-800 focus:outline-none lowercase\" required oninput=\"formatSlug(this)\" />\n                </div>\n              </div>\n            </form>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 max-w-2xl mb-6\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Kontak & Lokasi</h3>\n            <div class=\"space-y-5\">\n              <div>\n                <label for=\"store-wa\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">No. WhatsApp Warung</label>\n                <input type=\"tel\" id=\"store-wa\" value=\"081234567890\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" />\n              </div>\n              <div>\n                <label for=\"store-addr\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Alamat Lengkap</label>\n                <textarea id=\"store-addr\" rows=\"2\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"Jl. Diponegoro No. 123, Semarang\"></textarea>\n              </div>\n              <div>\n                <label for=\"store-map\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Link Google Maps</label>\n                <input type=\"url\" id=\"store-map\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"https://maps.google.com/...\" />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 max-w-2xl\">\n            <h3 class=\"font-display font-bold text-slate-800 mb-4\">Jam Operasional</h3>\n            <div class=\"space-y-3\">\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Senin</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"21:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Selasa</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"21:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Rabu</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"21:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Kamis</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"21:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Jumat</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"21:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Sabtu</span>\n                <div class=\"flex items-center gap-2\">\n                  <input type=\"time\" value=\"08:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                  <span class=\"text-slate-400\">-</span>\n                  <input type=\"time\" value=\"22:00\" class=\"bg-white border border-slate-200 rounded-lg px-2 py-1 text-sm\">\n                </div>\n              </div>\n              <div class=\"flex items-center justify-between p-3 bg-slate-50 rounded-xl\">\n                <span class=\"font-medium text-slate-700\">Minggu</span>\n                <label class=\"flex items-center gap-2 cursor-pointer\">\n                  <span class=\"text-sm text-slate-500\">Tutup</span>\n                  <input type=\"checkbox\" class=\"w-4 h-4 rounded border-slate-300 text-orange-500 focus:ring-orange-500/30\">\n                </label>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"mt-8 flex justify-end max-w-2xl\">\n            <button onclick=\"saveSettings()\" id=\"settings-submit-btn\" class=\"px-6 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-400 hover:to-orange-500 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/30 transition-all flex items-center gap-2\">\n              <span class=\"btn-text\">Simpan Semua Perubahan</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- ============ PAGE: MENUS ============ -->\n        <div id=\"page-menus\" class=\"page-view hidden\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6\">\n            <div>\n              <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Kelola Menu</h1>\n              <p class=\"text-slate-500\">Total ada <span id=\"total-menus\" class=\"font-semibold text-orange-600\">4</span> menu di warungmu.</p>\n            </div>\n            <button onclick=\"openMenuModal()\" class=\"w-full sm:w-auto px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center justify-center gap-2\">\n              <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 4v16m8-8H4\"/></svg>\n              Tambah Menu Baru\n            </button>\n          </div>\n\n          <!-- Search & Categories -->\n          <div class=\"flex flex-col sm:flex-row gap-4 mb-6\">\n            <div class=\"relative flex-1\">\n              <input type=\"text\" id=\"search-menu\" oninput=\"renderMenus()\" class=\"w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500\" placeholder=\"Cari menu...\">\n              <svg class=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"M21 21l-4.35-4.35\"/></svg>\n            </div>\n          </div>\n\n          <div class=\"flex gap-2 overflow-x-auto pb-2 mb-6 no-scrollbar\" id=\"category-pills\">\n            <!-- Generated by JS -->\n          </div>\n\n          <p class=\"text-xs text-slate-400 mb-4 flex items-center gap-1\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M5 9l-3 3m0 0l3 3m-3-3h18m0 0l-3-3m3 3l-3 3\"/></svg>\n            Tarik kartu menu untuk mengubah urutan tampilan di pelanggan\n          </p>\n\n          <div id=\"menu-grid\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\"></div>\n        </div>\n\n        <!-- ============ PAGE: DESIGNER ============ -->\n        <div id=\"page-designer\" class=\"page-view hidden\">\n          <div class=\"mb-8\">\n            <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Editor QR Code</h1>\n            <p class=\"text-slate-500\">Desain kartu QR Code sesuai brand warungmu. Download siap cetak.</p>\n          </div>\n\n          <div class=\"grid lg:grid-cols-2 gap-8\">\n            <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-6\">\n              <div>\n                <h3 class=\"font-display font-bold text-slate-800 mb-3\">1. Pilih Template</h3>\n                <div class=\"grid grid-cols-3 gap-3\">\n                  <button onclick=\"applyPreset('kopi-susu')\" class=\"preset-btn group\" data-preset=\"kopi-susu\">\n                    <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center\" style=\"background: #E8D0B3;\">\n                      <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                        <div style=\"background: #4E342E\"></div><div></div><div style=\"background: #4E342E\"></div>\n                        <div style=\"background: #4E342E\"></div><div style=\"background: #4E342E\"></div><div></div>\n                        <div></div><div style=\"background: #4E342E\"></div><div style=\"background: #4E342E\"></div>\n                      </div>\n                    </div>\n                    <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Kopi Susu</p>\n                  </button>\n                  <button onclick=\"applyPreset('sage-segar')\" class=\"preset-btn group\" data-preset=\"sage-segar\">\n                    <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center\" style=\"background: #B2AC88;\">\n                      <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                        <div style=\"background: #1A1A1A\"></div><div></div><div style=\"background: #1A1A1A\"></div>\n                        <div style=\"background: #1A1A1A\"></div><div style=\"background: #1A1A1A\"></div><div></div>\n                        <div></div><div style=\"background: #1A1A1A\"></div><div style=\"background: #1A1A1A\"></div>\n                      </div>\n                    </div>\n                    <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Sage Segar</p>\n                  </button>\n                  <button onclick=\"applyPreset('midnight-orange')\" class=\"preset-btn group\" data-preset=\"midnight-orange\">\n                    <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center\" style=\"background: #1A1A1A;\">\n                      <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                        <div style=\"background: #FF6D00\"></div><div></div><div style=\"background: #FF6D00\"></div>\n                        <div style=\"background: #FF6D00\"></div><div style=\"background: #FF6D00\"></div><div></div>\n                        <div></div><div style=\"background: #FF6D00\"></div><div style=\"background: #FF6D00\"></div>\n                      </div>\n                    </div>\n                    <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Midnight Orange</p>\n                  </button>\n                </div>\n                \n                <div class=\"mt-4 pt-4 border-t border-slate-100\">\n                  <p class=\"text-xs text-slate-400 mb-2\">Template Premium <span class=\"text-orange-500 font-semibold\">(Pro)</span></p>\n                  <div class=\"grid grid-cols-3 gap-3\">\n                    <button onclick=\"applyPreset('neon-cyber')\" class=\"preset-btn group\" data-preset=\"neon-cyber\">\n                      <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center relative\" style=\"background: #0F0F0F;\">\n                        <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                          <div style=\"background: #00F0FF\"></div><div></div><div style=\"background: #00F0FF\"></div>\n                          <div style=\"background: #00F0FF\"></div><div style=\"background: #00F0FF\"></div><div></div>\n                          <div></div><div style=\"background: #00F0FF\"></div><div style=\"background: #00F0FF\"></div>\n                        </div>\n                        <span class=\"absolute top-1 right-1 text-[8px] bg-orange-500 text-white px-1 py-0.5 rounded\">PRO</span>\n                      </div>\n                      <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Neon Cyber</p>\n                    </button>\n                    <button onclick=\"applyPreset('warm-pastel')\" class=\"preset-btn group\" data-preset=\"warm-pastel\">\n                      <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center relative\" style=\"background: #FFE4E6;\">\n                        <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                          <div style=\"background: #DB2777\"></div><div></div><div style=\"background: #DB2777\"></div>\n                          <div style=\"background: #DB2777\"></div><div style=\"background: #DB2777\"></div><div></div>\n                          <div></div><div style=\"background: #DB2777\"></div><div style=\"background: #DB2777\"></div>\n                        </div>\n                        <span class=\"absolute top-1 right-1 text-[8px] bg-orange-500 text-white px-1 py-0.5 rounded\">PRO</span>\n                      </div>\n                      <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Warm Pastel</p>\n                    </button>\n                    <button onclick=\"applyPreset('minimalist-black')\" class=\"preset-btn group\" data-preset=\"minimalist-black\">\n                      <div class=\"aspect-square rounded-xl border-2 border-transparent group-hover:border-orange-500 transition-all overflow-hidden flex items-center justify-center relative\" style=\"background: #FFFFFF; border: 1px solid #E2E8F0;\">\n                        <div class=\"w-3/4 h-3/4 grid grid-cols-3 gap-0.5\">\n                          <div style=\"background: #000000\"></div><div></div><div style=\"background: #000000\"></div>\n                          <div style=\"background: #000000\"></div><div style=\"background: #000000\"></div><div></div>\n                          <div></div><div style=\"background: #000000\"></div><div style=\"background: #000000\"></div>\n                        </div>\n                        <span class=\"absolute top-1 right-1 text-[8px] bg-orange-500 text-white px-1 py-0.5 rounded\">PRO</span>\n                      </div>\n                      <p class=\"text-xs font-medium text-slate-600 mt-2 text-center\">Minimalist Black</p>\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              <!-- Visual Color Picker -->\n              <div class=\"border-t border-slate-100 pt-6\">\n                <h3 class=\"font-display font-bold text-slate-800 mb-3\">2. Pilih Warna Bebas <span class=\"text-xs font-normal text-orange-500 bg-orange-50 px-2 py-0.5 rounded-full ml-1\">Pro</span></h3>\n                <div class=\"space-y-4\">\n                  <div>\n                    <label class=\"block text-sm text-slate-500 mb-2\">Warna Latar Kartu</label>\n                    <div class=\"flex flex-wrap gap-2 items-center\">\n                      <button onclick=\"setBgColor('#FFFFFF')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #FFFFFF;\"></button>\n                      <button onclick=\"setBgColor('#F8FAFC')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #F8FAFC;\"></button>\n                      <button onclick=\"setBgColor('#1A1A1A')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #1A1A1A;\"></button>\n                      <button onclick=\"setBgColor('#E8D0B3')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #E8D0B3;\"></button>\n                      <label class=\"relative w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm cursor-pointer overflow-hidden flex items-center justify-center bg-gradient-to-br from-red-500 via-yellow-500 to-blue-500 hover:scale-110 transition-transform\">\n                        <input type=\"color\" id=\"bg-color\" value=\"#E8D0B3\" class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\" onchange=\"applyCustomColor()\">\n                        <svg class=\"w-4 h-4 text-white drop-shadow-md\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\"/></svg>\n                      </label>\n                    </div>\n                  </div>\n                  <div>\n                    <label class=\"block text-sm text-slate-500 mb-2\">Warna QR Code</label>\n                    <div class=\"flex flex-wrap gap-2 items-center\">\n                      <button onclick=\"setQrColor('#000000')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #000000;\"></button>\n                      <button onclick=\"setQrColor('#1F2937')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #1F2937;\"></button>\n                      <button onclick=\"setQrColor('#F97316')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #F97316;\"></button>\n                      <button onclick=\"setQrColor('#EA580C')\" class=\"w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm hover:scale-110 transition-transform\" style=\"background: #EA580C;\"></button>\n                      <label class=\"relative w-9 h-9 rounded-lg border-2 border-slate-200 shadow-sm cursor-pointer overflow-hidden flex items-center justify-center bg-gradient-to-br from-red-500 via-yellow-500 to-blue-500 hover:scale-110 transition-transform\">\n                        <input type=\"color\" id=\"qr-color\" value=\"#4E342E\" class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\" onchange=\"applyCustomColor()\">\n                        <svg class=\"w-4 h-4 text-white drop-shadow-md\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\"/></svg>\n                      </label>\n                    </div>\n                  </div>\n                </div>\n                <div id=\"pro-badge-custom\" class=\"hidden mt-4 text-xs text-amber-600 bg-amber-50 border border-amber-100 rounded-lg p-2 flex items-center gap-2\">\n                  <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z\"/></svg>\n                  Anda menggunakan warna kustom. Watermark akan terlihat di preview.\n                </div>\n              </div>\n              \n              <!-- Table Number Input -->\n              <div class=\"border-t border-slate-100 pt-6\">\n                <h3 class=\"font-display font-bold text-slate-800 mb-3\">3. Nomor Meja (Opsional)</h3>\n                <input type=\"text\" id=\"table-number\" oninput=\"updateCardUI()\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-orange-500 focus:bg-white transition-all\" placeholder=\"Contoh: Meja 1 / Meja 5\" />\n                <p class=\"text-xs text-slate-400 mt-2\">Kosongkan jika kartu QR untuk display umum.</p>\n              </div>\n\n              <div class=\"border-t border-slate-100 pt-6 space-y-3\">\n                <button onclick=\"handleSaveDesign()\" id=\"save-design-btn\" class=\"w-full px-4 py-3 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold rounded-xl shadow-sm transition-all flex items-center justify-center gap-2\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg>\n                  Simpan Desain Kartu\n                </button>\n                <button onclick=\"handleDownload()\" id=\"download-btn\" class=\"w-full px-4 py-3 bg-slate-800 hover:bg-slate-900 text-white font-semibold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"/></svg>\n                  Download PDF / PNG High-Res\n                </button>\n              </div>\n            </div>\n\n            <div class=\"flex flex-col items-center justify-center bg-slate-100 rounded-2xl p-6 sm:p-10 relative\">\n              <div class=\"relative w-full max-w-xs\">\n                <div id=\"qr-card\" class=\"relative w-full aspect-[3/4] rounded-2xl shadow-2xl flex flex-col items-center justify-between p-6 transition-colors duration-300\" style=\"background: #E8D0B3;\">\n                  <div class=\"text-center\">\n                    <img id=\"qr-logo\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-12 h-12 rounded-full mx-auto mb-2 object-cover\" alt=\"Logo\">\n                    <h4 id=\"qr-store-name\" class=\"font-display font-bold text-lg\" style=\"color: #4E342E\">Warung Pak Bowo</h4>\n                  </div>\n                  <div class=\"bg-white p-3 rounded-xl shadow-sm w-3/4 aspect-square flex items-center justify-center\">\n                    <div id=\"qrcode\"></div>\n                  </div>\n                  <div class=\"text-center\">\n                    <p class=\"text-[10px] uppercase tracking-widest opacity-60\" style=\"color: #4E342E\">Scan untuk lihat menu</p>\n                    <p class=\"text-xs font-medium opacity-80\" style=\"color: #4E342E\">pesanlagi.web.id</p>\n                    <p id=\"qr-table-number\" class=\"hidden mt-1 text-xs font-bold px-2 py-0.5 rounded-full inline-block\" style=\"background-color: rgba(255,255,255,0.2); color: #4E342E\"></p>\n                  </div>\n                  <div id=\"watermark\" class=\"watermark-overlay hidden bg-black/20 rounded-2xl\">\n                    <div class=\"watermark-text\">PREVIEW MODE - UPGRADE PRO</div>\n                  </div>\n                </div>\n              </div>\n              <p class=\"text-xs text-slate-400 mt-6\">Preview Real-time</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- ============ PAGE: BILLING ============ -->\n        <div id=\"page-billing\" class=\"page-view hidden\">\n          <div class=\"mb-8\">\n            <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Tagihan & Paket</h1>\n            <p class=\"text-slate-500\">Kelola langganan dan metode pembayaranmu.</p>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6\">\n            <div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n              <div>\n                <p class=\"text-sm text-slate-500 mb-1\">Paket Aktif Saat Ini</p>\n                <h3 class=\"font-display text-2xl font-bold text-slate-800\">Paket Gratis (Free)</h3>\n                <p class=\"text-sm text-slate-500 mt-1\">Berlaku Selamanya</p>\n              </div>\n              <button onclick=\"document.getElementById('upgrade-modal').classList.remove('hidden')\" class=\"px-5 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/30 hover:from-orange-400 hover:to-orange-500 transition-all\">\n                Upgrade ke Pro\n              </button>\n        