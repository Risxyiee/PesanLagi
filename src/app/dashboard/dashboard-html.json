ss=\"text-sm font-medium text-white/80 truncate\">pengguna@warung.id</p>\n            <p class=\"text-[11px] text-orange-400/70\">Paket Gratis</p>\n          </div>\n        </div>\n        <button id=\"logout-btn\" class=\"w-full flex items-center justify-center gap-2 px-4 py-2 text-sm text-white/40 hover:text-red-400 hover:bg-red-500/10 rounded-lg\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n          Keluar\n        </button>\n      </div>\n    </aside>\n\n    <!-- ================= MAIN CONTENT ================= -->\n    <main class=\"flex-1 md:ml-[260px]\">\n      \n      <!-- Mobile Header (minimal) -->\n      <header class=\"md:hidden sticky top-0 z-20 px-4 py-3 flex items-center justify-between\">\n        <div class=\"flex items-center gap-2.5\">\n          <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center\">\n            <svg class=\"w-4 h-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><path d=\"M14 14h3v3h-3z M17 17h4 M14 21h3 M21 14v3 M21 21v.01\"/></svg>\n          </div>\n          <span class=\"font-display font-bold text-white text-sm\">PesanLagi</span>\n        </div>\n        <button id=\"mob-logout-btn\" class=\"p-2 text-white/30 hover:text-red-400 rounded-lg hover:bg-red-500/10\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n        </button>\n      </header>\n\n      <div class=\"p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto pb-24 md:pb-8\">\n\n        <!-- ============ PAGE: OVERVIEW ============ -->\n        <div id=\"page-overview\" class=\"page-view hidden\">\n\n          <!-- Greeting Card -->\n          <div class=\"glass-card mb-6\">\n            <div class=\"glass-card-inner p-6 sm:p-8\">\n              <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <div>\n                  <p class=\"text-white/40 text-sm mb-1\">Dashboard</p>\n                  <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-white mb-1\">Ringkasan Warung</h1>\n                  <p id=\"dash-greeting\" class=\"text-white/50\">Memuat...</p>\n                </div>\n                <a id=\"dash-public-link\" href=\"/menu/\" target=\"_blank\" class=\"btn-glass px-4 py-2.5 font-medium rounded-xl flex items-center justify-center gap-2 whitespace-nowrap\">\n                  <svg class=\"w-4 h-4 text-orange-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/><path d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\"/></svg>\n                  Lihat Menu Publik\n                </a>\n              </div>\n            </div>\n          </div>\n\n          <!-- Stat Cards -->\n          <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6\">\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-4 sm:p-5 flex items-center gap-3 sm:gap-4\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16M4 10h16M4 14h16M4 18h16\"/></svg>\n                </div>\n                <div class=\"min-w-0\">\n                  <p class=\"text-xs text-white/40 mb-0.5\">Total Menu</p>\n                  <p class=\"text-xl sm:text-2xl font-bold text-white\" id=\"stat-total-menus\">0</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-4 sm:p-5 flex items-center gap-3 sm:gap-4\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z\"/></svg>\n                </div>\n                <div class=\"min-w-0\">\n                  <p class=\"text-xs text-white/40 mb-0.5\">Total Kategori</p>\n                  <p id=\"stat-categories\" class=\"text-xl sm:text-2xl font-bold text-white\">0</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-4 sm:p-5 flex items-center gap-3 sm:gap-4\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg>\n                </div>\n                <div class=\"min-w-0\">\n                  <p class=\"text-xs text-white/40 mb-0.5\">Paket</p>\n                  <p id=\"stat-plan\" class=\"text-xl sm:text-2xl font-bold text-white\">Gratis</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-4 sm:p-5 flex items-center gap-3 sm:gap-4\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/><path d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\"/></svg>\n                </div>\n                <div class=\"min-w-0\">\n                  <p class=\"text-xs text-white/40 mb-0.5\">Scan Bulan Ini</p>\n                  <p id=\"stat-scans\" class=\"text-xl sm:text-2xl font-bold text-white\">0</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Quick Actions -->\n          <div class=\"grid grid-cols-3 gap-3 sm:gap-4 mb-6\">\n            <button onclick=\"navigateTo('menus')\" class=\"glass-card group\">\n              <div class=\"glass-card-inner p-4 flex items-center gap-3 hover:bg-white/[0.06]\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path d=\"M12 4v16m8-8H4\"/></svg>\n                </div>\n                <div class=\"text-left min-w-0\">\n                  <p class=\"text-xs sm:text-sm font-medium text-white/80\">Tambah Menu</p>\n                  <p class=\"text-[10px] sm:text-xs text-white/30 hidden sm:block\">Buat menu baru</p>\n                </div>\n              </div>\n            </button>\n            <button onclick=\"navigateTo('designer')\" class=\"glass-card group\">\n              <div class=\"glass-card-inner p-4 flex items-center gap-3 hover:bg-white/[0.06]\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/></svg>\n                </div>\n                <div class=\"text-left min-w-0\">\n                  <p class=\"text-xs sm:text-sm font-medium text-white/80\">Desain QR</p>\n                  <p class=\"text-[10px] sm:text-xs text-white/30 hidden sm:block\">Cetak kartu meja</p>\n                </div>\n              </div>\n            </button>\n            <button onclick=\"navigateTo('settings')\" class=\"glass-card group\">\n              <div class=\"glass-card-inner p-4 flex items-center gap-3 hover:bg-white/[0.06]\">\n                <div class=\"stat-icon text-orange-400 shrink-0\">\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n                </div>\n                <div class=\"text-left min-w-0\">\n                  <p class=\"text-xs sm:text-sm font-medium text-white/80\">Edit Profil</p>\n                  <p class=\"text-[10px] sm:text-xs text-white/30 hidden sm:block\">Ubah nama & jam buka</p>\n                </div>\n              </div>\n            </button>\n          </div>\n\n          <!-- Popular Menus + Chart -->\n          <div class=\"grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6\">\n            <div class=\"lg:col-span-3 glass-card\">\n              <div class=\"glass-card-inner p-5 sm:p-6\">\n                <h3 class=\"font-display font-bold text-white text-sm mb-4\">Statistik Scan (7 Hari Terakhir)</h3>\n                <div id=\"scan-chart-container\" class=\"flex items-end justify-between gap-2 h-32 pt-2\"></div>\n              </div>\n            </div>\n            <div class=\"lg:col-span-2 glass-card\">\n              <div class=\"glass-card-inner p-5 sm:p-6\">\n                <h3 class=\"font-display font-bold text-white text-sm mb-4\">Menu Terpopuler</h3>\n                <div id=\"popular-menus-list\" class=\"space-y-3\">\n                  <p class=\"text-sm text-white/30\">Belum ada menu.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- ============ PAGE: SETTINGS ============ -->\n        <div id=\"page-settings\" class=\"page-view hidden\">\n          <div class=\"mb-6\">\n            <p class=\"text-white/30 text-sm mb-1\">Pengaturan</p>\n            <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-white\">Profil Warung</h1>\n          </div>\n\n          <form id=\"settings-form\" class=\"space-y-4 max-w-2xl\">\n\n            <!-- Basic Info -->\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-5 sm:p-6 space-y-5\">\n                <h3 class=\"font-display font-bold text-white text-sm\">Informasi Dasar</h3>\n\n                <div>\n                  <label class=\"block text-xs font-medium text-white/50 mb-2\">Logo Warung</label>\n                  <div class=\"flex items-center gap-4\">\n                    <div class=\"w-16 h-16 rounded-2xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center overflow-hidden\">\n                      <img id=\"logo-preview\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-full h-full object-cover\" alt=\"Logo\">\n                    </div>\n                    <div>\n                      <button type=\"button\" onclick=\"document.getElementById('logo-upload').click()\" class=\"btn-glass px-4 py-2 text-xs font-medium rounded-lg\">Ganti Logo</button>\n                      <p class=\"text-[11px] text-white/25 mt-1.5\">PNG/JPG. Maks 1MB.</p>\n                      <input type=\"file\" id=\"logo-upload\" class=\"hidden\" accept=\"image/*\" onchange=\"handleLogoUpload(event)\">\n                    </div>\n                  </div>\n                </div>\n\n                <div>\n                  <label for=\"store-name\" class=\"block text-xs font-medium text-white/50 mb-1.5\">Nama Warung</label>\n                  <input type=\"text\" id=\"store-name\" value=\"\" class=\"w-full px-4 py-2.5 rounded-xl\" required oninput=\"autoGenerateSlug()\" />\n                </div>\n\n                <div>\n                  <label for=\"store-desc\" class=\"block text-xs font-medium text-white/50 mb-1.5\">Deskripsi Warung</label>\n                  <textarea id=\"store-desc\" rows=\"3\" class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"Contoh: Menyediakan masakan rumahan rasa Jawa asli sejak 1995.\"></textarea>\n                </div>\n\n                <div>\n                  <label for=\"store-slug\" class=\"block text-xs font-medium text-white/50 mb-1.5\">Link URL Menu (Slug)</label>\n                  <div class=\"flex items-center bg-white/[0.06] border border-white/[0.08] rounded-xl overflow-hidden\">\n                    <span class=\"pl-4 pr-2 py-2.5 text-xs text-white/25 border-r border-white/[0.08] whitespace-nowrap\">pesanlagi.web.id/menu/</span>\n                    <input type=\"text\" id=\"store-slug\" value=\"\" class=\"flex-1 pl-3 pr-4 py-2.5 bg-transparent text-white rounded-xl lowercase\" required oninput=\"formatSlug(this)\" />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Contact & Location -->\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-5 sm:p-6 space-y-5\">\n                <h3 class=\"font-display font-bold text-white text-sm\">Kontak & Lokasi</h3>\n                <div>\n                  <label for=\"store-wa\" class=\"block text-xs font-medium text-white/50 mb-1.5\">No. WhatsApp Warung</label>\n                  <input type=\"tel\" id=\"store-wa\" value=\"\" class=\"w-full px-4 py-2.5 rounded-xl\" />\n                </div>\n                <div>\n                  <label for=\"store-addr\" class=\"block text-xs font-medium text-white/50 mb-1.5\">Alamat Lengkap</label>\n                  <textarea id=\"store-addr\" rows=\"2\" class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"Jl. Diponegoro No. 123, Semarang\"></textarea>\n                </div>\n                <div>\n                  <label for=\"store-map\" class=\"block text-xs font-medium text-white/50 mb-1.5\">Link Google Maps</label>\n                  <input type=\"url\" id=\"store-map\" class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"https://maps.google.com/...\" />\n                </div>\n              </div>\n            </div>\n\n            <!-- Operating Hours -->\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-5 sm:p-6 space-y-4\">\n                <h3 class=\"font-display font-bold text-white text-sm\">Jam Operasional</h3>\n                <div id=\"hours-container\" class=\"space-y-2\">\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Senin</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-mon-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-mon-close\" value=\"21:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Selasa</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-tue-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-tue-close\" value=\"21:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Rabu</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-wed-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-wed-close\" value=\"21:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Kamis</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-thu-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-thu-close\" value=\"21:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Jumat</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-fri-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-fri-close\" value=\"21:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Sabtu</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-sat-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-white/25 text-xs\">\u2014</span><input type=\"time\" id=\"hour-sat-close\" value=\"22:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"></div></div>\n                  <div class=\"flex items-center justify-between p-3 bg-white/[0.03] rounded-xl\"><span class=\"text-sm font-medium text-white/70 w-20\">Minggu</span><div class=\"flex items-center gap-2\"><input type=\"time\" id=\"hour-sun-open\" value=\"08:00\" class=\"px-2 py-1.5 rounded-lg text-sm\"><span class=\"text-wh