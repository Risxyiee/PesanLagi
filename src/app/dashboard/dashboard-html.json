ont-bold text-slate-800\">Tambah Menu Baru</h3>\n        <button onclick=\"closeMenuModal()\" class=\"text-slate-400 hover:text-slate-600\">\n          <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M6 18L18 6M6 6l12 12\"/></svg>\n        </button>\n      </div>\n      \n      <form id=\"menu-form\" class=\"p-6 space-y-5\" onsubmit=\"saveMenu(event)\">\n        <input type=\"hidden\" id=\"menu-id\">\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Nama Menu</label>\n          <input type=\"text\" id=\"menu-name\" required class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"Contoh: Nasi Goreng Spesial\" />\n        </div>\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Deskripsi</label>\n          <textarea id=\"menu-desc\" rows=\"2\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"Beri tahu pelanggan apa yang membuat ini spesial\"></textarea>\n        </div>\n        \n        <div class=\"grid grid-cols-2 gap-4\">\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Harga (Rp)</label>\n            <input type=\"number\" id=\"menu-price\" required class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\" placeholder=\"15000\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Kategori</label>\n            <select id=\"menu-cat\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white\">\n              <!-- Options generated by JS -->\n            </select>\n          </div>\n        </div>\n        \n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Foto Menu</label>\n          <div class=\"flex items-center gap-4\">\n            <img id=\"menu-img-preview\" src=\"https://picsum.photos/seed/foodplaceholder/200/200.jpg\" class=\"w-16 h-16 rounded-xl object-cover bg-slate-100\" alt=\"Preview\">\n            <button type=\"button\" onclick=\"document.getElementById('menu-img-upload').click()\" class=\"px-3 py-1.5 text-xs font-medium text-orange-600 border border-orange-200 hover:bg-orange-50 rounded-lg\">Pilih Foto</button>\n            <input type=\"file\" id=\"menu-img-upload\" class=\"hidden\" accept=\"image/*\" onchange=\"handleMenuImageUpload(event)\">\n          </div>\n        </div>\n        \n        <div class=\"flex items-center justify-between bg-slate-50 p-4 rounded-xl\">\n          <div>\n            <p class=\"text-sm font-medium text-slate-800\">Status Ketersediaan</p>\n            <p class=\"text-xs text-slate-500\">Matikan jika menu sedang habis</p>\n          </div>\n          <label class=\"relative inline-flex items-center cursor-pointer\">\n            <input type=\"checkbox\" id=\"menu-available\" class=\"sr-only\" checked>\n            <div class=\"toggle-bg w-11 h-6 bg-slate-200 rounded-full\"></div>\n            <div class=\"toggle-dot absolute left-1 top-1 w-4 h-4 bg-white rounded-full shadow\"></div>\n          </label>\n        </div>\n        \n        <div class=\"flex gap-3 pt-2\">\n          <button type=\"button\" onclick=\"closeMenuModal()\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n          <button type=\"submit\" class=\"flex-1 py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/20 hover:from-orange-400 hover:to-orange-500\">Simpan Menu</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: DELETE CONFIRMATION ================= -->\n  <div id=\"delete-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center\">\n      <div class=\"w-16 h-16 mx-auto rounded-full bg-red-50 flex items-center justify-center mb-5\">\n        <svg class=\"w-8 h-8 text-red-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"/></svg>\n      </div>\n      <h3 class=\"font-display text-xl font-bold text-slate-800 mb-2\">Hapus Menu Ini?</h3>\n      <p class=\"text-slate-500 text-sm mb-6\">Menu yang dihapus tidak bisa dikembalikan. Yakin ingin melanjutkan?</p>\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('delete-modal')\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n        <button id=\"confirm-delete-btn\" class=\"flex-1 py-2.5 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600\">Hapus</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: ADD CATEGORY ================= -->\n  <div id=\"cat-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-sm p-6\">\n      <h3 class=\"font-display text-xl font-bold text-slate-800 mb-4\">Tambah Kategori Baru</h3>\n      <input type=\"text\" id=\"new-cat-name\" class=\"w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-orange-500 focus:bg-white mb-4\" placeholder=\"Contoh: Paket Komplit\" oninput=\"document.getElementById('add-cat-btn').disabled = !this.value.trim()\">\n      <div class=\"flex gap-3\">\n        <button onclick=\"closeModal('cat-modal')\" class=\"flex-1 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50\">Batal</button>\n        <button id=\"add-cat-btn\" onclick=\"addCategory()\" disabled class=\"flex-1 py-2.5 bg-orange-500 text-white font-semibold rounded-xl hover:bg-orange-600 disabled:opacity-50 disabled:cursor-not-allowed\">Tambah</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= MODAL: UPGRADE PRO ================= -->\n  <div id=\"upgrade-modal\" class=\"modal-overlay hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4\">\n    <div class=\"modal-box bg-white rounded-2xl shadow-xl w-full max-w-md p-8 text-center\">\n      <div class=\"w-16 h-16 mx-auto rounded-full bg-orange-100 flex items-center justify-center mb-5\">\n        <svg class=\"w-8 h-8 text-orange-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z\"/></svg>\n      </div>\n      <h3 class=\"font-display text-2xl font-bold text-slate-800 mb-2\">Upgrade ke Paket Pro</h3>\n      <p class=\"text-slate-500 mb-6\">Untuk menggunakan warna kustom dan menghilangkan watermark, kamu perlu upgrade akun ke Paket Pro.</p>\n      \n      <div class=\"bg-slate-50 rounded-xl p-4 mb-6 text-left\">\n        <div class=\"flex items-center gap-2 text-sm text-slate-700 mb-2\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Download PDF/PNG Tanpa Watermark\n        </div>\n        <div class=\"flex items-center gap-2 text-sm text-slate-700 mb-2\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Warna Kustom & Template Premium\n        </div>\n        <div class=\"flex items-center gap-2 text-sm text-slate-700\">\n          <svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n          Support Priority via WhatsApp\n        </div>\n      </div>\n      \n      <button onclick=\"closeModal('upgrade-modal'); showToast('Mengarahkan ke halaman pembayaran...')\" class=\"w-full py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/30 hover:scale-[1.02] transition-all mb-2\">\n        Upgrade Sekarang - Rp 29.000/bln\n      </button>\n      <button onclick=\"closeModal('upgrade-modal')\" class=\"w-full py-2 text-sm text-slate-400 hover:text-slate-600 font-medium\">Nanti Saja</button>\n    </div>\n  </div>\n\n  <!-- Toast Notification -->\n  <div id=\"toast\" class=\"fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-5 py-3 rounded-xl shadow-lg opacity-0 transition-opacity duration-300 z-[100] flex items-center gap-2 pointer-events-none\">\n    <svg class=\"w-5 h-5 text-orange-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n    <span id=\"toast-message\">Berhasil!</span>\n  </div>\n"