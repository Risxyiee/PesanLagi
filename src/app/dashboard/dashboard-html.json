L16.732 3.732z\"/></svg>\n                        </label>\n                      </div>\n                    </div>\n                    <div>\n                      <label class=\"block text-xs text-white/40 mb-2\">Warna QR Code</label>\n                      <div class=\"flex flex-wrap gap-2 items-center\">\n                        <button onclick=\"setQrColor('#000000')\" class=\"w-8 h-8 rounded-lg border border-white/15 hover:scale-110\" style=\"background:#000;\"></button>\n                        <button onclick=\"setQrColor('#1F2937')\" class=\"w-8 h-8 rounded-lg border border-white/15 hover:scale-110\" style=\"background:#1F2937;\"></button>\n                        <button onclick=\"setQrColor('#F97316')\" class=\"w-8 h-8 rounded-lg border border-white/15 hover:scale-110\" style=\"background:#F97316;\"></button>\n                        <button onclick=\"setQrColor('#EA580C')\" class=\"w-8 h-8 rounded-lg border border-white/15 hover:scale-110\" style=\"background:#EA580C;\"></button>\n                        <label class=\"relative w-8 h-8 rounded-lg border border-white/15 cursor-pointer overflow-hidden flex items-center justify-center bg-gradient-to-br from-red-500 via-yellow-500 to-blue-500 hover:scale-110\">\n                          <input type=\"color\" id=\"qr-color\" value=\"#4E342E\" class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\" onchange=\"applyCustomColor()\">\n                          <svg class=\"w-3.5 h-3.5 text-white drop-shadow-md\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\"/></svg>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div id=\"pro-badge-custom\" class=\"hidden text-[11px] text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-lg p-2.5 flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z\"/></svg>\n                    Warna kustom aktif. Watermark akan terlihat di preview.\n                  </div>\n                </div>\n              </div>\n\n              <!-- Table Number -->\n              <div class=\"glass-card\">\n                <div class=\"glass-card-inner p-5 space-y-4\">\n                  <h3 class=\"font-display font-bold text-white text-sm\">3. Nomor Meja (Opsional)</h3>\n                  <input type=\"text\" id=\"table-number\" oninput=\"updateCardUI()\" class=\"w-full px-4 py-2.5 rounded-xl\" placeholder=\"Contoh: Meja 1 / Meja 5\" />\n                  <p class=\"text-[11px] text-white/25\">Kosongkan jika kartu QR untuk display umum.</p>\n                </div>\n              </div>\n\n              <!-- Action Buttons -->\n              <div class=\"space-y-3\">\n                <button onclick=\"handleSaveDesign()\" id=\"save-design-btn\" class=\"btn-glass w-full px-4 py-3 font-semibold rounded-xl flex items-center justify-center gap-2\">\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg>\n                  Simpan Desain Kartu\n                </button>\n                <button onclick=\"handleDownload()\" id=\"download-btn\" class=\"btn-primary w-full px-4 py-3 font-semibold rounded-xl flex items-center justify-center gap-2\">\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"/></svg>\n                  Download PNG High-Res\n                </button>\n              </div>\n            </div>\n\n            <!-- QR Preview -->\n            <div class=\"glass-card\">\n              <div class=\"glass-card-inner p-6 sm:p-10 flex flex-col items-center justify-center\">\n                <div class=\"relative w-full max-w-[260px]\">\n                  <div id=\"qr-card\" class=\"relative w-full aspect-[3/4] rounded-2xl shadow-2xl flex flex-col items-center justify-between p-6\" style=\"background: #E8D0B3;\">\n                    <div class=\"text-center\">\n                      <img id=\"qr-logo\" src=\"https://picsum.photos/seed/warunglogo/200/200.jpg\" class=\"w-12 h-12 rounded-full mx-auto mb-2 object-cover\" alt=\"Logo\">\n                      <h4 id=\"qr-store-name\" class=\"font-display font-bold text-lg\" style=\"color: #4E342E\">--</h4>\n                    </div>\n                    <div class=\"bg-white p-3 rounded-xl shadow-sm w-3/4 aspect-square flex items-center justify-center\">\n                      <div id=\"qrcode\"></div>\n                    </div>\n                    <div class=\"text-center\">\n                      <p class=\"text-[10px] uppercase tracking-widest opacity-60\" style=\"color: #4E342E\">Scan untuk lihat menu</p>\n                      <p class=\"text-xs font-medium opacity-80\" style=\"color: #4E342E\">pesanlagi.web.id</p>\n                      <p id=\"qr-table-number\" class=\"hidden mt-1 text-xs font-bold px-2 py-0.5 rounded-full inline-block\" style=\"background-color: rgba(255,255,255,0.2); color: #4E342E\"></p>\n                    </div>\n                    <div id=\"watermark\" class=\"watermark-overlay hidden bg-black/20 rounded-2xl\">\n                      <div class=\"watermark-text\">PREVIEW - UPGRADE PRO</div>\n                    </div>\n                  </div>\n                </div>\n                <p class=\"text-[11px] text-white/25 mt-5\">Preview Real-time</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!