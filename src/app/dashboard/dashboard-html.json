800\">PesanLagi</span>\n        </div>\n        <button onclick=\"handleLogout()\" class=\"p-2 text-slate-500 hover:text-red-500\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n        </button>\n      </header>\n\n      <div class=\"p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto\">\n        \n        <!-- ============ PAGE: OVERVIEW ============ -->\n        <div id=\"page-overview\" class=\"page-view hidden\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8\">\n            <div>\n              <h1 class=\"font-display text-2xl sm:text-3xl font-bold text-slate-800 mb-1\">Ringkasan Warung</h1>\n              <p id=\"dash-greeting\" class=\"text-slate-500\">Memuat...</p>\n            </div>\n            <a id=\"dash-public-link\" href=\"/menu/\" target=\"_blank\" class=\"px-4 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium rounded-xl flex items-center justify-center gap-2 transition-colors\">\n              <svg class=\"w-5 h-5 text-orange-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/><path d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\"/></svg>\n              Lihat Menu Publik\n            </a>\n          </div>\n          \n          <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n            <div class=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n              <div class=\"w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16M4 10h16M4 14