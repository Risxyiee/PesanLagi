er gap-2\"><svg class=\"w-4 h-4 text-green-400 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> 3 Template Dasar</li>\n                  <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-400 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Watermark PesanLagi</li>\n                </ul>\n              </div>\n            </div>\n            <!-- Pro -->\n            <div class=\"glass-card\" style=\"border-color: rgba(249,115,22,0.3); box-shadow: 0 0 40px -10px rgba(249,115,22,0.2);\">\n              <div class=\"glass-card-inner p-5 sm:p-6 relative\">\n                <span class=\"absolute top-4 right-4 bg-orange-500 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full\">REKOMENDASI</span>\n                <h4 class=\"font-display font-bold text-white mb-3\">Paket Pro</h4>\n                <p class=\"font-display text-2xl sm:text-3xl font-bold text-white mb-4\">Rp 29.000<span class=\"text-sm font-medium text-white/40\">/bln</span></p>\n                <ul class=\"space-y-2.5 text-sm text-white/50\">\n                  <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-400 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Semua Fitur Gratis</li>\n                  <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-400 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Template & Warna Kustom</li>\n                  <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-400 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Download Tanpa Watermark</li>\n                  <li