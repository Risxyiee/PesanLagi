24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Semua Fitur Gratis</li>\n                <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Template & Warna Kustom</li>\n                <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Download PDF Tanpa Watermark</li>\n                <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Analytics Scan & View</li>\n                <li class=\"flex items-center gap-2\"><svg class=\"w-4 h-4 text-green-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Support Priority WhatsApp</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </main>\n  </div>\n\n  <!-- ================= BOTTOM NAV (MOBILE) ================= -->\n  <nav class=\"md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-100 z-30 grid grid-cols-5\">\n    <button onclick=\"navigateTo('overview')\" class=\"mob-nav flex flex-col items-center gap-1 py-3 text-slate-400\" data-page=\"overview\">\n      <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\"/></svg>\n      <span class=\"text-[10px] font-medium\">Beranda</span>\n    </button>\n    <button onclick=\"navigateTo('menus')\" class=\"mob-nav flex flex-col items-center gap-1 py-3 text-slate-400\" data-page=\"menus\">\n      <svg