tify-center\\\"><span class=\\\"bg-transparent px-4 text-xs text-slate-400 uppercase tracking-wider\\\">atau lanjutkan dengan</span></div>\\n          </div>\\n\\n          <div class=\\\"grid grid-cols-2 gap-3\\\">\\n            <button onclick=\\\"googleAuth()\\\" class=\\\"bg-white border border-slate-200 hover:border-slate-300 text-slate-700 font-medium py-2.5 rounded-xl transition-all flex items-center justify-center gap-2\\\">\\n              <svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\"><path fill=\\\"#4285F4\\\" d=\\\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\\\"/><path fill=\\\"#34A853\\\" d=\\\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\\\"/><path fill=\\\"#FBBC05\\\" d=\\\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\\\"/><path fill=\\\"#EA4335\\\" d=\\\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\\\"/></svg>\\n              Google\\n            </button>\\n            <button onclick=\\\"showToast('Integrasi Apple (demo)')\\\" class=\\\"bg-white border border-slate-200 hover:border-slate-300 text-slate-700 font-medium py-2.5 rounded-xl transition-all flex items-center justify-center gap-2\\\">\\n              <svg class=\\\"w-4 h-4 text-slate-900\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z\\\"/></svg>\\n              Apple\\n            </button>\\n          </div>\\n\\n          <p class=\\\"text-center text-sm text-slate-500 mt-8\\\">\\n            Belum punya akun warung? \\n            <a href=\\\"#register\\\" onclick=\\\"switchView('register')\\\" class=\\\"text-orange-600 font-semibold hover:text-orange-700\\\">Daftar Gratis</a>\\n          </p>\\n        </div>\\n\\n        <!-- ================= REGISTER VIEW ================= -->\\n        <div id=\\\"register-view\\\" class=\\\"view hidden\\\">\\n          <div class=\\\"mb-8\\\">\\n            <h1 class=\\\"font-display text-3xl font-bold text-slate-800 mb-2\\\">Buat Akun Baru \\ud83d\\ude80</h1>\\n            <p class=\\\"text-slate-500\\\">Gratis selamanya, tanpa biaya tersembunyi.</p>\\n          </div>\\n          \\n          <div id=\\\"register-error\\\" class=\\\"hidden bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl p-3.5 mb-5 flex items-center gap-2.5\\\">\\n            <svg class=\\\"w-5 h-5 flex-shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><line x1=\\\"12\\\" y1=\\\"8\\\" x2=\\\"12\\\" y2=\\\"12\\\"/><line x1=\\\"12\\\" y1=\\\"16\\\" x2=\\\"12.01\\\" y2=\\\"16\\\"/></svg>\\n            <span id=\\\"register-error-text\\\" class=\\\"font-medium\\\"></span>\\n          </div>\\n\\n          <form id=\\\"register-form\\\" class=\\\"space-y-5\\\">\\n            <div>\\n              <label for=\\\"register-email\\\" class=\\\"block text-sm font-medium text-slate-700 mb-1.5\\\">Email Warung</label>\\n              <input type=\\\"email\\\" id=\\\"register-email\\\" placeholder=\\\"contoh@warung.com\\\" class=\\\"w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 transition-all\\\" required />\\n            </div>\\n            \\n            <div>\\n              <label for=\\\"register-password\\\" class=\\\"block text-sm font-medium text-slate-700 mb-1.5\\\">Password</label>\\n              <div class=\\\"relative\\\">\\n                <input type=\\\"password\\\" id=\\\"register-password\\\" placeholder=\\\"Min. 6 karakter\\\" class=\\\"w-full px-4 py-3 pr-12 bg-white border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 transition-all\\\" required oninput=\\\"checkPasswordStrength()\\\" />\\n                <button type=\\\"button\\\" onclick=\\\"togglePassword('register-password', this)\\\" class=\\\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors p-1\\\">\\n                  <svg class=\\\"w-5 h-5 eye-icon\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\"/></svg>\\n                </button>\\n              </div>\\n              <!-- Password Strength Meter -->\\n              <div class=\\\"flex gap-1.5 mt-2\\\">\\n                <div id=\\\"strength-1\\\" class=\\\"strength-bar w-1/4\\\"></div>\\n                <div id=\\\"strength-2\\\" class=\\\"strength-bar w-1/4\\\"></div>\\n                <div id=\\\"strength-3\\\" class=\\\"strength-bar w-1/4\\\"></div>\\n                <div id=\\\"strength-4\\\" class=\\\"strength-bar w-1/4\\\"></div>\\n              </div>\\n              <p id=\\\"strength-text\\\" class=\\\"text-xs text-slate-400 mt-1.5\\\">Gunakan minimal 6 karakter</p>\\n            </div>\\n\\n            <div>\\n              <label for=\\\"register-confirm\\\" class=\\\"block text-sm font-medium text-slate-700 mb-1.5\\\">Konfirmasi Password</label>\\n              <div class=\\\"relative\\\">\\n                <input type=\\\"password\\\" id=\\\"register-confirm\\\" placeholder=\\\"Ulangi password\\\" class=\\\"w-full px-4 py-3 pr-12 bg-white border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 transition-all\\\" required />\\n                <button type=\\\"button\\\" onclick=\\\"togglePassword('register-confirm', this)\\\" class=\\\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors p-1\\\">\\n                  <svg class=\\\"w-5 h-5 eye-icon\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\"/></svg>\\n                </button>\\n              </div>\\n            </div>\\n            \\n            <label class=\\\"flex items-start gap-2 cursor-pointer\\\">\\n              <input type=\\\"checkbox\\\" id=\\\"register-terms\\\" class=\\\"w-4 h-4 mt-0.5 rounded border-slate-300 text-orange-500 focus:ring-orange-500/30\\\" required />\\n              <span class=\\\"text-sm text-slate-600\\\">Saya setuju dengan <a href=\\\"#\\\" class=\\\"text-orange-600 font-medium hover:underline\\\">Syarat & Ketentuan</a> serta <a href=\\\"#\\\" class=\\\"text-orange-600 font-medium hover:underline\\\">Kebijakan Privasi</a> PesanLagi.</span>\\n            </label>\\n            \\n            <button type=\\\"submit\\\" id=\\\"register-btn\\\" class=\\\"w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-400 hover:to-orange-500 text-white font-semibold py-3.5 rounded-xl transition-all shadow-lg shadow-orange-500/30 hover:shadow-orange-500/40 hover:-translate-y-0.5 flex items-center justify-center gap-2\\\">\\n              <span class=\\\"btn-text\\\">Buat Akun Warung Gratis</span>\\n            </button>\\n          </form>\\n\\n          <p class=\\\"text-center text-sm text-slate-500 mt-8\\\">\\n            Sudah punya akun? \\n            <a href=\\\"#login\\\" onclick=\\\"switchView('login')\\\" class=\\\"text-orange-600 font-semibold hover:text-orange-700\\\">Masuk di sini</a>\\n          </p>\\n        </div>\\n\\n        <!-- ================= SUCCESS VIEW ================= -->\\n        <div id=\\\"success-view\\\" class=\\\"view hidden text-center py-10\\\">\\n          <div class=\\\"w-20 h-20 mx-auto rounded-full bg-green-100 flex items-center justify-center mb-6\\\">\\n            <svg class=\\\"w-10 h-10 text-green-500\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"3\\\" viewBox=\\\"0 0 24 24\\\"><polyline points=\\\"20 6 9 17 4 12\\\"/></svg>\\n          </div>\\n          <h2 id=\\\"success-title\\\" class=\\\"font-display text-2xl font-bold text-slate-800 mb-2\\\">Berhasil!</h2>\\n          <p id=\\\"success-msg\\\" class=\\\"text-slate-500 mb-8\\\">Mengarahkan ke dashboard...</p>\\n          <div class=\\\"w-full bg-slate-100 rounded-full h-1.5 overflow-hidden\\\">\\n            <div id=\\\"success-bar\\\" class=\\\"bg-gradient-to-r from-orange-500 to-orange-600 h-full rounded-full transition-all duration-[2500ms] ease-linear\\\" style=\\\"width: 0%\\\"></div>\\n          </div>\\n        </div>\\n\\n      </div>\\n      \\n      <!-- Footer Link -->\\n      <div class=\\\"mt-12 text-center relative z-10\\\">\\n        <a href=\\\"#\\\" onclick=\\\"showToast('Mengarahkan ke Landing Page...')\\\" class=\\\"text-sm text-slate-400 hover:text-slate-600 inline-flex items-center gap-1.5 transition-colors\\\">\\n          <svg class=\\\"w-4 h-4\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M19 12H5M12 19l-7-7 7-7\\\"/></svg>\\n          Kembali ke Beranda\\n        </a>\\n      </div>\\n    </div>\\n  </div>\\n\\n  <!-- Toast -->\\n  <div id=\\\"toast\\\" class=\\\"fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-5 py-3 rounded-xl shadow-lg opacity-0 transition-opacity duration-300 z-50 flex items-center gap-2 pointer-events-none\\\">\\n    <svg class=\\\"w-5 h-5 text-orange-400\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><path d=\\\"M12 16v-4M12 8h.01\\\"/></svg>\\n    <span id=\\\"toast-message\\\">Message</span>\\n  </div>\""