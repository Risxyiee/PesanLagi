"<div class=\"min-h-screen flex flex-col items-center justify-center p-4 sm:p-6 relative overflow-hidden\" style=\"background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 30%, #FEF3C7 70%, #FFFBEB 100%);\">\n\n  <!-- Background Decorations -->\n  <div class=\"absolute top-[-20%] right-[-10%] w-[500px] h-[500px] rounded-full opacity-30 pointer-events-none\" style=\"background: radial-gradient(circle, #FDBA74 0%, transparent 70%);\"></div>\n  <div class=\"absolute bottom-[-15%] left-[-10%] w-[400px] h-[400px] rounded-full opacity-20 pointer-events-none\" style=\"background: radial-gradient(circle, #FCD34D 0%, transparent 70%);\"></div>\n  <div class=\"absolute top-[10%] left-[5%] w-3 h-3 rounded-full bg-orange-300/40 animate-pulse\"></div>\n  <div class=\"absolute top-[30%] right-[15%] w-2 h-2 rounded-full bg-amber-300/40 animate-pulse\" style=\"animation-delay: 0.5s;\"></div>\n  <div class=\"absolute bottom-[20%] left-[20%] w-2.5 h-2.5 rounded-full bg-orange-400/30 animate-pulse\" style=\"animation-delay: 1s;\"></div>\n\n  <!-- Main Card -->\n  <div class=\"w-full max-w-[420px] relative z-10\">\n\n    <!-- Logo + Brand -->\n    <div class=\"text-center mb-8\">\n      <div class=\"inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 shadow-lg\" style=\"background: linear-gradient(135deg, #F97316, #EA580C); box-shadow: 0 8px 24px -4px rgba(249,115,22,0.4);\">\n        <svg class=\"w-7 h-7 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/>\n          <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/>\n          <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/>\n          <path d=\"M14 14h3v3h-3z\"/>\n          <path d=\"M17 17h4\"/>\n          <path d=\"M14 21h3\"/>\n          <path d=\"M21 14v3\"/>\n          <path d=\"M21 21v.01\"/>\n        </svg>\n      </div>\n      <h1 class=\"font-display text-2xl font-bold text-stone-800\">PesanLagi</h1>\n      <p class=\"text-stone-400 text-sm mt-1\">QR Menu Digital untuk Warungmu</p>\n    </div>\n\n    <!-- Card Body -->\n    <div class=\"bg-white rounded-3xl shadow-xl shadow-orange-900/5 border border-stone-100 p-6 sm:p-8\">\n\n      <!-- ================= LOGIN VIEW ================= -->\n      <div id=\"login-view\" class=\"view\">\n        <div class=\"mb-6\">\n          <h2 class=\"font-display text-xl font-bold text-stone-800 mb-1\">Masuk ke Akun</h2>\n          <p class=\"text-stone-400 text-sm\">Kelola menu warungmu dari satu tempat.</p>\n        </div>\n\n        <!-- Error Alert -->\n        <div id=\"login-error\" class=\"hidden bg-red-50 border border-red-100 text-red-600 text-sm rounded-2xl p-3.5 mb-5 flex items-center gap-2.5\">\n          <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\n          <span id=\"login-error-text\" class=\"font-medium\"></span>\n        </div>\n\n        <form id=\"login-form\" class=\"space-y-4\">\n          <div>\n            <label for=\"login-email\" class=\"block text-xs font-semibold text-stone-500 mb-1.5 uppercase tracking-wide\">Email</label>\n            <div class=\"relative\">\n              <svg class=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-300\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M22 7l-10 7L2 7\"/></svg>\n              <input type=\"email\" id=\"login-email\" placeholder=\"nama@warung.com\" class=\"w-full pl-10 pr-4 py-3 bg-stone-50 border border-stone-200 rounded-xl text-stone-800 text-sm placeholder-stone-300 focus:outline-none focus:bg-white focus:border-orange-400 focus:ring-4 focus:ring-orange-400/10 transition-all\" required />\n            </div>\n          </div>\n\n          <div>\n            <div class=\"flex items-center justify-between mb-1.5\">\n              <label for=\"login-password\" class=\"block text-xs font-semibold text-stone-500 uppercase tracking-wide\">Password</label>\n              <a href=\"#\" onclick=\"showForgotPassword()\" class=\"text-xs font-medium text-orange-600 hover:text-orange-700 transition-colors\">Lupa password?</a>\n            </div>\n            <div class=\"relative\">\n              <svg class=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-300\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0110 0v4\"/></svg>\n              <input type=\"password\" id=\"login-password\" placeholder=\"Masukkan password\" class=\"w-full pl-10 pr-11 py-3 bg-stone-50 border border-stone-200 rounded-xl text-stone-800 text-sm placeholder-stone-300 focus:outline-none focus:bg-white focus:border-orange-400 focus:ring-4 focus:ring-orange-400/10 transition-all\" required />\n              <button type=\"button\" onclick=\"togglePassword('login-password', this)\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-300 hover:text-stone-500 transition-colors p-0.5\">\n                <svg class=\"w-4 h-4 eye-icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n              </button>\n            </div>\n          </div>\n\n          <button type=\"submit\" id=\"login-btn\" class=\"w-full text-white font-semibold text-sm py-3 rounded-xl transition-all duration-200 flex items-center justify-center gap-2\" style=\"background: linear-gradient(135deg, #F97316, #EA580C); box-shadow: 0 4px 14px -3px rgba(249,115,22,0.5);\">\n            <span class=\"btn-text\">Masuk</span>\n          </button>\n        </form>\n\n        <!-- Divider -->\n        <div class=\"relative my-6\">\n          <div class=\"absolute inset-0 flex items-center\"><div class=\"w-full border-t border-stone-100\"></div></div>\n          <div class=\"relative flex justify-center\"><span class=\"bg-white px-3.5 text-xs text-stone-300\">atau</span></div>\n        </div>\n\n        <!-- Google Button -->\n        <button onclick=\"googleAuth()\" class=\"w-full bg-white border border-stone-200 hover:bg-stone-50 hover:border-stone-300 text-stone-600 font-medium text-sm py-2.5 rounded-xl transition-all duration-200 flex items-center justify-center gap-2.5\">\n          <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\"><path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/><path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/><path fill=\"#FBBC05\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/><path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/></svg>\n          Masuk dengan Google\n        </button>\n\n        <p class=\"text-center text-sm text-stone-400 mt-6\">\n          Belum punya akun?\n          <a href=\"#register\" onclick=\"switchView('register')\" class=\"text-orange-600 font-semibold hover:text-orange-700 transition-colors\">Daftar gratis</a>\n        </p>\n      </div>\n\n      <!-- ================= REGISTER VIEW ================= -->\n      <div id=\"register-view\" class=\"view hidden\">\n        <div class=\"mb-6\">\n          <h2 class=\"font-display text-xl font-bold text-stone-800 mb-1\">Buat Akun Baru</h2>\n          <p class=\"text-stone-400 text-sm\">Gratis selamanya untuk warungmu.</p>\n        </div>\n\n        <div id=\"register-error\" class=\"hidden bg-red-50 border border-red-100 text-red-600 text-sm rounded-2xl p-3.5 mb-5 flex items-center gap-2.5\">\n          <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\n          <span id=\"register-error-text\" class=\"font-medium\"></span>\n        </div>\n\n        <form id=\"register-form\" class=\"space-y-4\">\n          <div>\n            <label for=\"register-email\" class=\"block text-xs font-semibold text-stone-500 mb-1.5 uppercase tracking-wide\">Email Warung</label>\n            <div class=\"relative\">\n              <svg class=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-300\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M22 7l-10 7L2 7\"/></svg>\n              <input type=\"email\" id=\"register-email\" placeholder=\"nama@warung.com\" class=\"w-full pl-10 pr-4 py-3 bg-stone-50 border border-stone-200 rounded-xl text-stone-800 text-sm placeholder-stone-300 focus:outline-none focus:bg-white focus:border-orange-400 focus:ring-4 focus:ring-orange-400/10 transition-all\" required />\n            </div>\n          </div>\n\n          <div>\n            <label for=\"register-password\" class=\"block text-xs font-semibold text-stone-500 mb-1.5 uppercase tracking-wide\">Password</label>\n            <div class=\"relative\">\n              <svg class=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-300\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0110 0v4\"/></svg>\n              <input type=\"password\" id=\"register-password\" placeholder=\"Minimal 6 karakter\" class=\"w-full pl-10 pr-11 py-3 bg-stone-50 border border-stone-200 rounded-xl text-stone-800 text-sm placeholder-stone-300 focus:outline-none focus:bg-white focus:border-orange-400 focus:ring-4 focus:ring-orange-400/10 transition-all\" required oninput=\"checkPasswordStrength()\" />\n              <button type=\"button\" onclick=\"togglePassword('register-password', this)\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-300 hover:text-stone-500 transition-colors p-0.5\">\n                <svg class=\"w-4 h-4 eye-icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n              </button>\n            </div>\n            <div class=\"flex gap-1 mt-2.5\">\n              <div id=\"strength-1\" class=\"strength-bar w-1/4\"></div>\n              <div id=\"strength-2\" class=\"strength-bar w-1/4\"></div>\n              <div id=\"strength-3\" class=\"strength-bar w-1/4\"></div>\n              <div id=\"strength-4\" class=\"strength-bar w-1/4\"></div>\n            </div>\n            <p id=\"strength-text\" class=\"text-xs text-stone-400 mt-1\">Gunakan minimal 6 karakter</p>\n          </div>\n\n          <div>\n            <label for=\"register-confirm\" class=\"block text-xs font-semibold text-stone-500 mb-1.5 uppercase tracking-wide\">Konfirmasi Password</label>\n            <div class=\"relative\">\n              <svg class=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-300\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              <input type=\"password\" id=\"register-confirm\" placeholder=\"Ulangi password\" class=\"w-full pl-10 pr-11 py-3 bg-stone-50 border border-stone-200 rounded-xl text-stone-800 text-sm placeholder-stone-300 focus:outline-none focus:bg-white focus:border-orange-400 focus:ring-4 focus:ring-orange-400/10 transition-all\" required />\n              <button type=\"button\" onclick=\"togglePassword('register-confirm', this)\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-300 hover:text-stone-500 transition-colors p-0.5\">\n                <svg class=\"w-4 h-4 eye-icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n              </button>\n            </div>\n          </div>\n\n          <label class=\"flex items-start gap-2.5 cursor-pointer pt-1\">\n            <input type=\"checkbox\" id=\"register-terms\" class=\"w-4 h-4 mt-0.5 rounded border-stone-300 text-orange-500 focus:ring-orange-500/30\" required />\n            <span class=\"text-xs text-stone-400 leading-relaxed\">Saya setuju dengan <a href=\"#\" class=\"text-orange-600 font-medium hover:underline\">Syarat &amp; Ketentuan</a></span>\n          </label>\n\n          <button type=\"submit\" id=\"register-btn\" class=\"w-full text-white font-semibold text-sm py-3 rounded-xl transition-all duration-200 flex items-center justify-center gap-2\" style=\"background: linear-gradient(135deg, #F97316, #EA580C); box-shadow: 0 4px 14px -3px rgba(249,115,22,0.5);\">\n            <span class=\"btn-text\">Daftar Gratis</span>\n          </button>\n        </form>\n\n        <p class=\"text-center text-sm text-stone-400 mt-6\">\n          Sudah punya akun?\n          <a href=\"#login\" onclick=\"switchView('login')\" class=\"text-orange-600 font-semibold hover:text-orange-700 transition-colors\">Masuk di sini</a>\n        </p>\n      </div>\n\n      <!-- ================= SUCCESS VIEW ================= -->\n      <div id=\"success-view\" class=\"view hidden text-center py-8\">\n        <div class=\"w-16 h-16 mx-auto rounded-full bg-emerald-50 flex items-center justify-center mb-5\">\n          <svg class=\"w-8 h-8 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n        </div>\n        <h2 id=\"success-title\" class=\"font-display text-lg font-bold text-stone-800 mb-1\">Berhasil!</h2>\n        <p id=\"success-msg\" class=\"text-stone-400 text-sm mb-6\">Mengarahkan ke dashboard...</p>\n        <div class=\"w-full bg-stone-100 rounded-full h-1.5 overflow-hidden\">\n          <div id=\"success-bar\" class=\"h-full rounded-full transition-all duration-[2500ms] ease-linear\" style=\"width: 0%; background: linear-gradient(90deg, #F97316, #EA580C);\"></div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Back to Home -->\n    <div class=\"mt-6 text-center\">\n      <a href=\"#\" onclick=\"goToLanding()\" class=\"inline-flex items-center gap-1.5 text-sm text-stone-400 hover:text-stone-600 transition-colors\">\n        <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 12H5\"/><path d=\"M12 19l-7-7 7-7\"/></svg>\n        Kembali ke Beranda\n      </a>\n    </div>\n  </div>\n\n  <!-- Toast -->\n  <div id=\"toast\" class=\"fixed bottom-6 left-1/2 -translate-x-1/2 bg-stone-800 text-white text-sm px-5 py-3 rounded-2xl shadow-lg opacity-0 transition-opacity duration-300 z-50 flex items-center gap-2 pointer-events-none\">\n    <svg class=\"w-4 h-4 text-orange-400 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4\"/><path d=\"M12 8h.01\"/></svg>\n    <span id=\"toast-message\">Message</span>\n  </div>\n</div>"