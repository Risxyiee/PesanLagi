600 bg-clip-text text-transparent\\\">Tanpa Ribet.</span>\\n        </h2>\\n        <p class=\\\"text-orange-100/60 max-w-md text-lg leading-relaxed\\\">\\n          Satu dashboard untuk semua kebutuhan menu digitalmu. Update harga, foto, dan cetak QR code hanya dari smartphone.\\n        </p>\\n        \\n        <!-- Mockup Card -->\\n        <div class=\\\"mt-10 relative w-72 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl\\\">\\n          <div class=\\\"flex items-center gap-3 mb-4\\\">\\n            <div class=\\\"w-10 h-10 rounded-full bg-gradient-to-br from-orange-400 to-red-500\\\"></div>\\n            <div>\\n              <div class=\\\"h-3 w-24 bg-white/20 rounded-full mb-1.5\\\"></div>\\n              <div class=\\\"h-2 w-16 bg-white/10 rounded-full\\\"></div>\\n            </div>\\n            <div class=\\\"ml-auto h-6 w-16 bg-green-500/20 rounded-full border border-green-500/30\\\"></div>\\n          </div>\\n          <div class=\\\"space-y-2.5\\\">\\n            <div class=\\\"flex items-center gap-3\\\">\\n              <div class=\\\"w-12 h-12 rounded-lg bg-orange-500/20\\\"></div>\\n              <div class=\\\"flex-1 space-y-1.5\\\">\\n                <div class=\\\"h-2.5 w-3/4 bg-white/15 rounded-full\\\"></div>\\n                <div class=\\\"h-2 w-1/2 bg-white/10 rounded-full\\\"></div>\\n              </div>\\n            </div>\\n            <div class=\\\"flex items-center gap-3\\\">\\n              <div class=\\\"w-12 h-12 rounded-lg bg-orange-500/20\\\"></div>\\n              <div class=\\\"flex-1 space-y-1.5\\\">\\n                <div class=\\\"h-2.5 w-2/3 bg-white/15 rounded-full\\\"></div>\\n                <div class=\\\"h-2 w-1/3 bg-white/10 rounded-full\\\"></div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n      \\n      <!-- Footer -->\\n      <div class=\\\"relative z-10 flex items-center justify-between text-xs text-orange-100/40\\\">\\n       